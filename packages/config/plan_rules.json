{
  "version": 1,
  "owner": "Qoovex",
  "purpose": "Single source of truth for pricing plans, feature access, and usage limits during development.",
  "canonical_plan_order": ["FREE", "START", "PRO", "ENTERPRISE"],
  "currency": "EUR",
  "global_rules": {
    "workspace_is_personal_and_independent": true,
    "joining_other_users_work_plans_is_free_and_unlimited": true,
    "work_plan_limits_apply_only_to_plan_creation_and_members_per_plan": true,
    "only_work_plan_creator_can_create_tasks": true,
    "work_plan_members_can_complete_tasks": true,
    "task_completion_notifies_creator": true,
    "work_tasks_can_be_free_text_or_recipe_snapshot": true,
    "shopping_list_handles_prices": false
  },
  "enforcement_notes": {
    "recipe_limit": "Counts recipes owned by the workspace.",
    "menu_limit": "Counts menus owned by the workspace.",
    "work_plan_creation_limit": "Applies only to plans created by the user, never to joined plans.",
    "members_per_plan_limit": "Applies per created work plan.",
    "active_work_plan_limit": "Only active plans count toward the limit.",
    "unlimited": "When mode is unlimited, application logic must not enforce a numeric cap."
  },
  "plans": {
    "FREE": {
      "label": "Free",
      "monthly_price": {
        "type": "fixed",
        "value": 0
      },
      "limits": {
        "recipes": { "mode": "limited", "value": 50 },
        "menus": { "mode": "limited", "value": 2 },
        "creatable_work_plans": { "mode": "limited", "value": 0 },
        "active_work_plans": { "mode": "limited", "value": 0 },
        "members_per_plan": { "mode": "limited", "value": 0 }
      },
      "features": {
        "menu_watermark": true,
        "custom_qr": false,
        "shopping_list_export": false,
        "activity_log": false,
        "api_access": false,
        "dedicated_sla_support": false
      },
      "notes": [
        "Free users can participate in other users' work plans without limit.",
        "Free users cannot create work plans."
      ]
    },
    "START": {
      "label": "Start",
      "monthly_price": {
        "type": "approximate",
        "value": 19
      },
      "limits": {
        "recipes": { "mode": "limited", "value": 300 },
        "menus": { "mode": "limited", "value": 6 },
        "creatable_work_plans": { "mode": "limited", "value": 1 },
        "active_work_plans": { "mode": "limited", "value": 1 },
        "members_per_plan": { "mode": "limited", "value": 5 }
      },
      "features": {
        "menu_watermark": false,
        "custom_qr": false,
        "shopping_list_export": false,
        "activity_log": false,
        "api_access": false,
        "dedicated_sla_support": false
      },
      "notes": []
    },
    "PRO": {
      "label": "Pro",
      "monthly_price": {
        "type": "approximate",
        "value": 49
      },
      "limits": {
        "recipes": { "mode": "unlimited", "value": null },
        "menus": { "mode": "unlimited", "value": null },
        "creatable_work_plans": { "mode": "limited", "value": 3 },
        "active_work_plans": { "mode": "limited", "value": 3 },
        "members_per_plan": { "mode": "limited", "value": 10 }
      },
      "features": {
        "menu_watermark": false,
        "custom_qr": true,
        "shopping_list_export": true,
        "activity_log": true,
        "api_access": false,
        "dedicated_sla_support": false
      },
      "notes": []
    },
    "ENTERPRISE": {
      "label": "ENTERPRISE",
      "monthly_price": {
        "type": "custom",
        "value": null
      },
      "limits": {
        "recipes": { "mode": "unlimited", "value": null },
        "menus": { "mode": "unlimited", "value": null },
        "creatable_work_plans": { "mode": "unlimited", "value": null },
        "active_work_plans": { "mode": "unlimited", "value": null },
        "members_per_plan": { "mode": "unlimited", "value": null }
      },
      "features": {
        "menu_watermark": false,
        "custom_qr": true,
        "shopping_list_export": true,
        "activity_log": true,
        "api_access": true,
        "dedicated_sla_support": true
      },
      "notes": [
        "ENTERPRISE plan is custom and should be handled as enterprise/custom sales flow."
      ]
    }
  },
  "feature_to_plan_mapping": {
    "menu_watermark_removed": ["START", "PRO", "ENTERPRISE"],
    "custom_qr": ["PRO", "ENTERPRISE"],
    "shopping_list_export": ["PRO", "ENTERPRISE"],
    "activity_log": ["PRO", "ENTERPRISE"],
    "api_access": ["ENTERPRISE"],
    "dedicated_sla_support": ["ENTERPRISE"]
  },
  "gating_examples": {
    "can_create_work_plan": "plan.limits.creatable_work_plans.mode === 'unlimited' || createdWorkPlansCount < plan.limits.creatable_work_plans.value",
    "can_add_member_to_plan": "plan.limits.members_per_plan.mode === 'unlimited' || currentMembersCount < plan.limits.members_per_plan.value",
    "can_create_recipe": "plan.limits.recipes.mode === 'unlimited' || ownedRecipesCount < plan.limits.recipes.value",
    "can_create_menu": "plan.limits.menus.mode === 'unlimited' || ownedMenusCount < plan.limits.menus.value"
  }
}
