{
  "name": "@qoovex/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "styles",
    "animations",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    "./styles/tokens": "./styles/tokens.css",
    "./styles/base": "./styles/base.css",
    "./styles/themes": {
      "types": "./dist/styles/themes/index.d.ts",
      "import": "./dist/styles/themes/index.js",
      "default": "./dist/styles/themes/index.js"
    },
    "./config/variants": {
      "types": "./dist/config/variants.d.ts",
      "import": "./dist/config/variants.js",
      "default": "./dist/config/variants.js"
    },
    "./animations/motion": "./animations/motion.css",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^6"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
