{
  "name": "@qoovex/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm tokens:check && tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings=0 src",
    "test": "vitest run",
    "tokens:check": "tsx scripts/generate-tokens.ts --check",
    "tokens:generate": "tsx scripts/generate-tokens.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.22.0",
    "typescript": "^6",
    "typescript-eslint": "8.54.0",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@qoovex/types": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
