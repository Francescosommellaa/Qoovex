model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                          String                                @id @default(cuid())
  name                        String?
  email                       String                                @unique
  emailVerified               DateTime?
  image                       String?
  firstName                   String                                @default("")
  lastName                    String?
  username                    String                                @unique
  usernameOnboarded           Boolean                               @default(true)
  profileOnboarded            Boolean                               @default(true)
  avatarBlobPathname          String?
  phoneNumber                 String?
  platformRole                PlatformRole                          @default(USER)
  accountRole                 AccountRole?
  authVersion                 Int                                   @default(1)
  suspendedAt                 DateTime?
  suspensionReason            String?
  accounts                    Account[]
  sessions                    Session[]
  credential                  UserCredential?
  authCodes                   AuthCode[]
  authRateLimits              AuthRateLimit[]
  securityEvents              SecurityAuditEvent[]
  mfaEnabled                  Boolean                               @default(false)
  totpSecretEncrypted         String?
  totpSecretNonce             String?
  totpPendingSecretEncrypted  String?
  totpPendingSecretNonce      String?
  totpPendingCreatedAt        DateTime?
  totpVerifiedAt              DateTime?
  usernameChangedAt           DateTime?
  mfaBackupCodes              MfaBackupCode[]
  mfaRecoveryRequests         MfaRecoveryRequest[]                  @relation("MfaRecoverySubject")
  approvedMfaRecoveries       MfaRecoveryRequest[]                  @relation("MfaRecoveryApprover")
  deniedMfaRecoveries         MfaRecoveryRequest[]                  @relation("MfaRecoveryDenier")
  authDevices                 AuthDevice[]
  organizationMemberships     OrganizationMembership[]
  createdOrganizations        Organization[]                        @relation("OrganizationCreator")
  sentOrganizationInvitations OrganizationInvitation[]              @relation("InvitationSender")
  grantedMembershipResources  OrganizationMembershipResourceGrant[] @relation("MembershipResourceGrantActor")
  updatedMembershipAccesses   OrganizationMembership[]              @relation("MembershipAccessUpdater")
  updatedInvitationAccesses   OrganizationInvitation[]              @relation("InvitationAccessUpdater")
  supportSessions             SupportSession[]                      @relation("SupportActor")
  supportAuditEvents          SupportAuditEvent[]                   @relation("SupportAuditActor")
  productAuditEvents          ProductAuditEvent[]                   @relation("ProductAuditActor")
  notifications               Notification[]
  requestedDataControlJobs    DataControlJob[]                      @relation("DataControlJobRequester")
  resolvedRuntimeErrors       RuntimeErrorEvent[]                   @relation("RuntimeErrorResolver")
  workerUserLinks             WorkerUserLink[]
  linkedWorkerUserLinks       WorkerUserLink[]                      @relation("WorkerUserLinkCreator")
  jobSiteParticipants         JobSiteParticipant[]
  clientProperties            ClientProperty[]
  notificationPreferences     NotificationPreference[]
  notificationDeliveries      NotificationDelivery[]
  assignedJobSiteWorkers      JobSiteWorkerAssignment[]             @relation("JobSiteWorkerAssignmentCreator")
  endedJobSiteWorkers         JobSiteWorkerAssignment[]             @relation("JobSiteWorkerAssignmentEnder")
  organizationContacts        OrganizationContact[]
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt
}

model Organization {
  id                       String                                @id @default(cuid())
  name                     String
  code                     String                                @unique
  createdById              String?
  createdAt                DateTime                              @default(now())
  updatedAt                DateTime                              @updatedAt
  createdBy                User?                                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships              OrganizationMembership[]
  invitations              OrganizationInvitation[]
  membershipResourceGrants OrganizationMembershipResourceGrant[]
  invitationResourceGrants OrganizationInvitationResourceGrant[]
  supportSessions          SupportSession[]
  supportEvents            SupportAuditEvent[]
  productAuditEvents       ProductAuditEvent[]
  mfaRecoveryRequests      MfaRecoveryRequest[]
  workers                  Worker[]
  jobSites                 JobSite[]
  notifications            Notification[]
  workerUserLinks          WorkerUserLink[]
  jobSiteParticipants      JobSiteParticipant[]
  jobSiteWorkerAssignments JobSiteWorkerAssignment[]
  profile                  OrganizationProfile?
  contacts                 OrganizationContact[]
  clientInvitations        JobSiteClientInvitation[]
  clientPropertyLinks      ClientPropertyJobSiteLink[]
  authorityGrants          JobSiteAuthorityGrant[]
  initialAgreements        JobSiteInitialAgreement[]
  jobSiteSteps             JobSiteStep[]
  timelineEvents           JobSiteTimelineEvent[]
  jobSiteAttachments       JobSiteAttachment[]
  jobSiteRequests          JobSiteRequest[]
  changeProposals          JobSiteChangeProposal[]
  paymentProfiles          OrganizationPaymentProfile[]
  paymentRequests          JobSitePaymentRequest[]
  disputes                 JobSiteDispute[]
  closures                 JobSiteClosure[]
  postClosureRequests      JobSitePostClosureRequest[]
  reopeningProposals       JobSiteReopeningProposal[]
  jobSiteExports           JobSiteExport[]
  legalHolds               LegalHold[]
  actionReceipts           JobSiteActionReceipt[]
  jobSiteProcesses         JobSiteProcess[]
  notificationPreferences  NotificationPreference[]
  notificationDeliveries   NotificationDelivery[]

  @@index([name])
}

model OrganizationProfile {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  legalName               String?
  taxCode                 String?
  vatNumber               String?
  registeredOfficeAddress String?      @db.Text
  operatingDescription    String?      @db.Text
  specializations         String[]     @default([])
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, legalName])
}

model OrganizationContact {
  id             String                  @id @default(cuid())
  organizationId String
  userId         String?
  kind           OrganizationContactKind @default(GENERAL)
  name           String
  email          String?
  phone          String?
  position       String?
  isPrimary      Boolean                 @default(false)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  archivedAt     DateTime?
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, archivedAt, sortOrder])
  @@index([organizationId, kind, archivedAt])
  @@index([userId])
}

model Worker {
  id                 String                        @id @default(cuid())
  organizationId     String
  displayName        String
  email              String?
  phone              String?
  roleLabel          String?
  status             RecordStatus                  @default(ACTIVE)
  notes              String?                       @db.Text
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  archivedAt         DateTime?
  organization       Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userLinks          WorkerUserLink[]
  jobSiteAssignments JobSiteWorkerAssignment[]
  stepAssignments    JobSiteStepWorkerAssignment[]
  invitations        OrganizationInvitation[]

  @@index([organizationId, status])
  @@index([organizationId, displayName])
  @@index([organizationId, email])
}

model JobSite {
  id                          String                      @id @default(cuid())
  organizationId              String
  name                        String
  address                     String?
  description                 String?                     @db.Text
  status                      JobSiteStatus               @default(DRAFT)
  revision                    Int                         @default(1)
  timelineSequence            BigInt                      @default(0)
  historicalCreatorUserId     String?
  responsibleParticipantId    String?
  estimatedCompletionAt       DateTime?
  estimatedCompletionAuthorId String?
  estimatedCompletionSetAt    DateTime?
  startDate                   DateTime?
  endDate                     DateTime?
  closedAt                    DateTime?
  archivedAt                  DateTime?
  notes                       String?                     @db.Text
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  organization                Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  participants                JobSiteParticipant[]
  responsibleParticipant      JobSiteParticipant?         @relation("JobSiteResponsibleParticipant", fields: [responsibleParticipantId], references: [id], onDelete: SetNull)
  workerAssignments           JobSiteWorkerAssignment[]
  clientInvitations           JobSiteClientInvitation[]
  propertyLinks               ClientPropertyJobSiteLink[]
  authorityGrants             JobSiteAuthorityGrant[]
  initialAgreement            JobSiteInitialAgreement?
  steps                       JobSiteStep[]
  timelineEvents              JobSiteTimelineEvent[]
  attachments                 JobSiteAttachment[]
  requests                    JobSiteRequest[]
  changeProposals             JobSiteChangeProposal[]
  paymentRequests             JobSitePaymentRequest[]
  disputes                    JobSiteDispute[]
  closures                    JobSiteClosure[]
  postClosureRequests         JobSitePostClosureRequest[]
  reopeningProposals          JobSiteReopeningProposal[]
  exports                     JobSiteExport[]
  legalHolds                  LegalHold[]
  actionReceipts              JobSiteActionReceipt[]
  processes                   JobSiteProcess[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, name])
  @@index([historicalCreatorUserId])
  @@index([responsibleParticipantId])
}

model WorkerUserLink {
  id             String       @id @default(cuid())
  organizationId String
  workerId       String
  userId         String
  linkedById     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedBy       User         @relation("WorkerUserLinkCreator", fields: [linkedById], references: [id], onDelete: Restrict)

  @@index([organizationId, workerId, archivedAt])
  @@index([organizationId, userId, archivedAt])
  @@index([organizationId, createdAt])
  @@index([linkedById])
}

model JobSiteWorkerAssignment {
  id                   String       @id @default(cuid())
  organizationId       String
  jobSiteId            String
  workerId             String
  operationalRoleLabel String?
  taskLabel            String?
  startsAt             DateTime     @default(now())
  endsAt               DateTime?
  endedById            String?
  endReason            String?      @db.Text
  assignedById         String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  archivedAt           DateTime?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite              JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  worker               Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy           User         @relation("JobSiteWorkerAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy              User?        @relation("JobSiteWorkerAssignmentEnder", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([organizationId, jobSiteId, archivedAt], map: "JobSiteWorkerAssignment_org_job_archived_idx")
  @@index([organizationId, workerId, archivedAt], map: "JobSiteWorkerAssignment_org_worker_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
  @@index([organizationId, startsAt, endsAt])
  @@index([endedById])
}

model Notification {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  severity       NotificationSeverity
  title          String
  message        String                 @db.Text
  sourceType     NotificationSourceType
  sourceId       String?
  dedupeKey      String
  actionHref     String?
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, userId, dismissedAt, readAt])
  @@index([organizationId, type, sourceType, sourceId])
  @@index([organizationId, severity, createdAt])
}

model DataControlJob {
  id             String               @id @default(cuid())
  organizationId String
  requestedById  String
  type           DataControlJobType
  status         DataControlJobStatus @default(PENDING)
  attemptCount   Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  activeKey      String?              @unique
  blobKey        String?
  resultSummary  Json?
  errorCode      String?
  createdAt      DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  requestedBy    User                 @relation("DataControlJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, type, status])
  @@index([status, nextAttemptAt, createdAt])
  @@index([requestedById, createdAt])
  @@index([blobKey])
}

model JobSiteParticipant {
  id                  String                              @id @default(cuid())
  organizationId      String
  jobSiteId           String
  userId              String
  membershipId        String?
  kind                JobSiteParticipantKind
  status              JobSiteParticipantStatus            @default(PENDING)
  accessVersion       Int                                 @default(1)
  publicRoleLabel     String?
  activeKey           String?                             @unique
  primaryClientKey    String?                             @unique
  userSideKey         String                              @unique
  invitedAt           DateTime?
  activatedAt         DateTime?
  suspendedAt         DateTime?
  endedAt             DateTime?
  revokedAt           DateTime?
  createdByUserId     String?
  endedByUserId       String?
  endReason           String?                             @db.Text
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt
  organization        Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobSite             JobSite                             @relation(fields: [jobSiteId], references: [id], onDelete: Restrict)
  user                User                                @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership          OrganizationMembership?             @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  responsibleFor      JobSite[]                           @relation("JobSiteResponsibleParticipant")
  acceptedInvitations JobSiteClientInvitation[]
  authorityGrants     JobSiteAuthorityGrant[]
  agreementConsents   JobSiteInitialAgreementConsent[]
  stepAssignments     JobSiteStepUserAssignment[]
  proposalConsents    JobSiteChangeProposalConsent[]
  disputeConsents     JobSiteDisputeConsent[]
  closureConsents     JobSiteClosureConsent[]
  reopeningConsents   JobSiteReopeningConsent[]
  requestedPayments   JobSitePaymentRequest[]             @relation("PaymentRequestRequester")
  paymentDeclarations JobSitePaymentTransferDeclaration[] @relation("PaymentDeclarationActor")
  paymentReviews      JobSitePaymentReview[]              @relation("PaymentReviewActor")

  @@index([organizationId, jobSiteId, kind, status])
  @@index([userId, status])
  @@index([membershipId])
}

model JobSiteClientInvitation {
  id                      String                 @id @default(cuid())
  organizationId          String
  jobSiteId               String
  emailNormalized         String
  tokenHash               String                 @unique
  activeKey               String?                @unique
