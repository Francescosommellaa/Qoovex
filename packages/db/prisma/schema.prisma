generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  MFA_ENROLLMENT
  MFA_RECOVERY
}

enum MfaRecoveryMode {
  SELF_EMAIL
  OWNER_APPROVAL
}

enum MfaRecoveryStatus {
  PENDING
  APPROVED
  DENIED
  SETUP_STARTED
  COMPLETED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPPORT_AGENT
  PLATFORM_ADMIN
}

enum OrganizationRole {
  OWNER
  COLLABORATOR
}

enum OrganizationAccessPreset {
  READ_ONLY
  OPERATIONAL_COLLABORATION
  SITE_MANAGER
  DOCUMENT_REVIEWER
  LIMITED_UPLOAD
  CUSTOM
}

enum OrganizationScopeMode {
  FULL
  ASSIGNED
}

enum OrganizationResourceType {
  JOB_SITE
  WORKER
  DOCUMENT
  EVIDENCE
}

enum SupportAuditAction {
  READ
  WRITE
  SENSITIVE
  EXPORT
}

enum AuditAction {
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_ARCHIVED
  DOCUMENT_VERSION_UPLOADED
  DOCUMENT_VERSION_DOWNLOADED
  DOCUMENT_VERSION_ARCHIVED
  WORKER_CREATED
  WORKER_UPDATED
  WORKER_ARCHIVED
  JOB_SITE_CREATED
  JOB_SITE_UPDATED
  JOB_SITE_ARCHIVED
  EVIDENCE_CREATED
  EVIDENCE_UPDATED
  EVIDENCE_DOWNLOADED
  EVIDENCE_ARCHIVED
  NOTIFICATION_READ
  NOTIFICATION_DISMISSED
  WORKER_USER_LINK_CREATED
  WORKER_USER_LINK_ARCHIVED
  JOB_SITE_USER_ASSIGNMENT_CREATED
  JOB_SITE_USER_ASSIGNMENT_ARCHIVED
  JOB_SITE_WORKER_ASSIGNMENT_CREATED
  JOB_SITE_WORKER_ASSIGNMENT_ARCHIVED
  ORGANIZATION_PROFILE_UPDATED
  ORGANIZATION_CONTACT_CREATED
  ORGANIZATION_CONTACT_UPDATED
  ORGANIZATION_CONTACT_ARCHIVED
  DOCUMENT_JOB_SITE_LINK_CREATED
  DOCUMENT_JOB_SITE_LINK_ARCHIVED
  ORGANIZATION_INVITATION_CREATED
  ORGANIZATION_INVITATION_REVOKED
  ORGANIZATION_INVITATION_ACCEPTED
  ORGANIZATION_MEMBERSHIP_REVOKED
  DATA_EXPORT_GENERATED
  DATA_EXPORT_FAILED
  DATA_CONTROL_JOB_CREATED
  DATA_CONTROL_JOB_RUN
  ORPHAN_BLOB_CLEANUP_RUN
  ORGANIZATION_DELETE_REQUESTED
  ORGANIZATION_DELETE_RUN
  SECURITY_DENIED
}

enum AuditEntityType {
  DOCUMENT
  DOCUMENT_VERSION
  WORKER
  JOB_SITE
  EVIDENCE
  NOTIFICATION
  DATA_CONTROL_JOB
  WORKER_USER_LINK
  JOB_SITE_USER_ASSIGNMENT
  JOB_SITE_WORKER_ASSIGNMENT
  ORGANIZATION_INVITATION
  ORGANIZATION_MEMBERSHIP
  ORGANIZATION
  ORGANIZATION_PROFILE
  ORGANIZATION_CONTACT
  DOCUMENT_JOB_SITE_LINK
  EVIDENCE_REVISION
  USER
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentOwnerType {
  ORGANIZATION
  WORKER
  JOB_SITE
}

enum EvidenceType {
  PHOTO
  FILE
  NOTE
}

enum OrganizationContactKind {
  GENERAL
  ADMINISTRATION
  SAFETY
  TECHNICAL
}

enum NotificationType {
  SYSTEM
}

enum NotificationSeverity {
  INFO
  ATTENTION
  WARNING
}

enum NotificationSourceType {
  SYSTEM
}

enum JobSiteUserAssignmentRole {
  SITE_MANAGER
  DOCUMENT_REVIEWER
  CONTRIBUTOR
}

enum DataControlJobType {
  METADATA_EXPORT
  ORGANIZATION_DELETE
  ORPHAN_BLOB_CLEANUP
}

enum DataControlJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RuntimeErrorStatus {
  OPEN
  RESOLVED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                          String                                @id @default(cuid())
  name                        String?
  email                       String                                @unique
  emailVerified               DateTime?
  image                       String?
  firstName                   String                                @default("")
  lastName                    String?
  username                    String                                @unique
  usernameOnboarded           Boolean                               @default(true)
  profileOnboarded            Boolean                               @default(true)
  avatarBlobPathname          String?
  phoneNumber                 String?
  platformRole                PlatformRole                          @default(USER)
  authVersion                 Int                                   @default(1)
  suspendedAt                 DateTime?
  suspensionReason            String?
  accounts                    Account[]
  sessions                    Session[]
  credential                  UserCredential?
  authCodes                   AuthCode[]
  authRateLimits              AuthRateLimit[]
  securityEvents              SecurityAuditEvent[]
  mfaEnabled                  Boolean                               @default(false)
  totpSecretEncrypted         String?
  totpSecretNonce             String?
  totpPendingSecretEncrypted  String?
  totpPendingSecretNonce      String?
  totpPendingCreatedAt        DateTime?
  totpVerifiedAt              DateTime?
  usernameChangedAt           DateTime?
  mfaBackupCodes              MfaBackupCode[]
  mfaRecoveryRequests         MfaRecoveryRequest[]                  @relation("MfaRecoverySubject")
  approvedMfaRecoveries       MfaRecoveryRequest[]                  @relation("MfaRecoveryApprover")
  deniedMfaRecoveries         MfaRecoveryRequest[]                  @relation("MfaRecoveryDenier")
  authDevices                 AuthDevice[]
  organizationMembership      OrganizationMembership?
  createdOrganizations        Organization[]                        @relation("OrganizationCreator")
  sentOrganizationInvitations OrganizationInvitation[]              @relation("InvitationSender")
  grantedMembershipResources  OrganizationMembershipResourceGrant[] @relation("MembershipResourceGrantActor")
  updatedMembershipAccesses   OrganizationMembership[]              @relation("MembershipAccessUpdater")
  updatedInvitationAccesses   OrganizationInvitation[]              @relation("InvitationAccessUpdater")
  supportSessions             SupportSession[]                      @relation("SupportActor")
  supportAuditEvents          SupportAuditEvent[]                   @relation("SupportAuditActor")
  productAuditEvents          ProductAuditEvent[]                   @relation("ProductAuditActor")
  uploadedDocumentVersions    DocumentVersion[]                     @relation("DocumentVersionUploader")
  createdEvidence             Evidence[]                            @relation("EvidenceCreator")
  evidenceRevisions           EvidenceRevision[]                    @relation("EvidenceRevisionActor")
  notifications               Notification[]
  requestedDataControlJobs    DataControlJob[]                      @relation("DataControlJobRequester")
  resolvedRuntimeErrors       RuntimeErrorEvent[]                   @relation("RuntimeErrorResolver")
  workerUserLinks             WorkerUserLink[]
  linkedWorkerUserLinks       WorkerUserLink[]                      @relation("WorkerUserLinkCreator")
  jobSiteUserAssignments      JobSiteUserAssignment[]
  assignedJobSiteUsers        JobSiteUserAssignment[]               @relation("JobSiteUserAssignmentCreator")
  endedJobSiteUsers           JobSiteUserAssignment[]               @relation("JobSiteUserAssignmentEnder")
  assignedJobSiteWorkers      JobSiteWorkerAssignment[]             @relation("JobSiteWorkerAssignmentCreator")
  endedJobSiteWorkers         JobSiteWorkerAssignment[]             @relation("JobSiteWorkerAssignmentEnder")
  linkedDocumentJobSites      DocumentJobSiteLink[]                 @relation("DocumentJobSiteLinkCreator")
  unlinkedDocumentJobSites    DocumentJobSiteLink[]                 @relation("DocumentJobSiteLinkEnder")
  organizationContacts        OrganizationContact[]
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt
}

model Organization {
  id                       String                                @id @default(cuid())
  name                     String
  code                     String                                @unique
  createdById              String?
  createdAt                DateTime                              @default(now())
  updatedAt                DateTime                              @updatedAt
  createdBy                User?                                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships              OrganizationMembership[]
  invitations              OrganizationInvitation[]
  membershipResourceGrants OrganizationMembershipResourceGrant[]
  invitationResourceGrants OrganizationInvitationResourceGrant[]
  supportSessions          SupportSession[]
  supportEvents            SupportAuditEvent[]
  productAuditEvents       ProductAuditEvent[]
  mfaRecoveryRequests      MfaRecoveryRequest[]
  workers                  Worker[]
  jobSites                 JobSite[]
  documents                Document[]
  documentVersions         DocumentVersion[]
  evidence                 Evidence[]
  notifications            Notification[]
  workerUserLinks          WorkerUserLink[]
  jobSiteUserAssignments   JobSiteUserAssignment[]
  jobSiteWorkerAssignments JobSiteWorkerAssignment[]
  profile                  OrganizationProfile?
  contacts                 OrganizationContact[]
  documentJobSiteLinks     DocumentJobSiteLink[]
  evidenceRevisions        EvidenceRevision[]

  @@index([name])
}

model OrganizationProfile {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  legalName               String?
  taxCode                 String?
  vatNumber               String?
  registeredOfficeAddress String?      @db.Text
  operatingDescription    String?      @db.Text
  specializations         String[]     @default([])
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, legalName])
}

model OrganizationContact {
  id             String                  @id @default(cuid())
  organizationId String
  userId         String?
  kind           OrganizationContactKind @default(GENERAL)
  name           String
  email          String?
  phone          String?
  position       String?
  isPrimary      Boolean                 @default(false)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  archivedAt     DateTime?
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, archivedAt, sortOrder])
  @@index([organizationId, kind, archivedAt])
  @@index([userId])
}

model Worker {
  id                 String                    @id @default(cuid())
  organizationId     String
  displayName        String
  email              String?
  phone              String?
  roleLabel          String?
  status             RecordStatus              @default(ACTIVE)
  notes              String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  archivedAt         DateTime?
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          Document[]
  evidence           Evidence[]
  userLinks          WorkerUserLink[]
  jobSiteAssignments JobSiteWorkerAssignment[]
  invitations        OrganizationInvitation[]

  @@index([organizationId, status])
  @@index([organizationId, displayName])
  @@index([organizationId, email])
}

model JobSite {
  id                String                    @id @default(cuid())
  organizationId    String
  name              String
  address           String?
  status            RecordStatus              @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?                   @db.Text
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents         Document[]
  evidence          Evidence[]
  userAssignments   JobSiteUserAssignment[]
  workerAssignments JobSiteWorkerAssignment[]
  documentLinks     DocumentJobSiteLink[]

  @@index([organizationId, status])
  @@index([organizationId, name])
}

model WorkerUserLink {
  id             String       @id @default(cuid())
  organizationId String
  workerId       String
  userId         String
  linkedById     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedBy       User         @relation("WorkerUserLinkCreator", fields: [linkedById], references: [id], onDelete: Restrict)

  @@index([organizationId, workerId, archivedAt])
  @@index([organizationId, userId, archivedAt])
  @@index([organizationId, createdAt])
  @@index([linkedById])
}

model JobSiteUserAssignment {
  id                   String                    @id @default(cuid())
  organizationId       String
  jobSiteId            String
  userId               String
  assignmentRole       JobSiteUserAssignmentRole @default(SITE_MANAGER)
  operationalRoleLabel String?
  taskLabel            String?
  startsAt             DateTime                  @default(now())
  endsAt               DateTime?
  endedById            String?
  endReason            String?                   @db.Text
  assignedById         String
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  archivedAt           DateTime?
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite              JobSite                   @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy           User                      @relation("JobSiteUserAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy              User?                     @relation("JobSiteUserAssignmentEnder", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([organizationId, jobSiteId, assignmentRole, archivedAt], map: "JobSiteUserAssignment_org_job_role_archived_idx")
  @@index([organizationId, userId, assignmentRole, archivedAt], map: "JobSiteUserAssignment_org_user_role_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
  @@index([organizationId, startsAt, endsAt])
  @@index([endedById])
}

model JobSiteWorkerAssignment {
  id                   String       @id @default(cuid())
  organizationId       String
  jobSiteId            String
  workerId             String
  operationalRoleLabel String?
  taskLabel            String?
  startsAt             DateTime     @default(now())
  endsAt               DateTime?
  endedById            String?
  endReason            String?      @db.Text
  assignedById         String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  archivedAt           DateTime?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite              JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  worker               Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy           User         @relation("JobSiteWorkerAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy              User?        @relation("JobSiteWorkerAssignmentEnder", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([organizationId, jobSiteId, archivedAt], map: "JobSiteWorkerAssignment_org_job_archived_idx")
  @@index([organizationId, workerId, archivedAt], map: "JobSiteWorkerAssignment_org_worker_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
  @@index([organizationId, startsAt, endsAt])
  @@index([endedById])
}

model Document {
  id               String                @id @default(cuid())
  organizationId   String
  currentVersionId String?               @unique
  ownerType        DocumentOwnerType
  workerId         String?
  jobSiteId        String?
  title            String
  notes            String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  archivedAt       DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentVersion   DocumentVersion?      @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  worker           Worker?               @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobSite          JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]
  jobSiteLinks     DocumentJobSiteLink[]

  @@index([organizationId, ownerType])
  @@index([organizationId, workerId])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, title])
}

model DocumentVersion {
  id                 String       @id @default(cuid())
  organizationId     String
  documentId         String
  blobKey            String
  originalFileName   String
  mimeType           String
  size               Int
  checksum           String?
  uploadedById       String
  createdAt          DateTime     @default(now())
  archivedAt         DateTime?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document           Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy         User         @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  currentForDocument Document?    @relation("DocumentCurrentVersion")

  @@index([organizationId, documentId, createdAt])
  @@index([organizationId, uploadedById])
  @@index([organizationId, blobKey])
}

model DocumentJobSiteLink {
  id             String       @id @default(cuid())
  organizationId String
  documentId     String
  jobSiteId      String
  purpose        String?
  validFrom      DateTime?
  validTo        DateTime?
  linkedById     String
  unlinkedAt     DateTime?
  unlinkedById   String?
  unlinkReason   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  jobSite        JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  linkedBy       User         @relation("DocumentJobSiteLinkCreator", fields: [linkedById], references: [id], onDelete: Restrict)
  unlinkedBy     User?        @relation("DocumentJobSiteLinkEnder", fields: [unlinkedById], references: [id], onDelete: SetNull)

  @@index([organizationId, documentId, unlinkedAt])
  @@index([organizationId, jobSiteId, unlinkedAt])
  @@index([organizationId, validFrom, validTo])
  @@index([linkedById])
  @@index([unlinkedById])
}

model Evidence {
  id               String             @id @default(cuid())
  organizationId   String
  jobSiteId        String?
  workerId         String?
  type             EvidenceType
  title            String
  description      String?            @db.Text
  capturedAt       DateTime?
  blobKey          String?
  originalFileName String?
  mimeType         String?
  size             Int?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archivedAt       DateTime?
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite          JobSite?           @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  worker           Worker?            @relation(fields: [workerId], references: [id], onDelete: SetNull)
  createdBy        User               @relation("EvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revisions        EvidenceRevision[]

  @@index([organizationId, type])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, workerId])
  @@index([organizationId, createdAt])
  @@index([organizationId, title])
}

model EvidenceRevision {
  id             String       @id @default(cuid())
  organizationId String
  evidenceId     String
  revisionNumber Int
  title          String
  description    String?      @db.Text
  capturedAt     DateTime?
  reason         String?      @db.Text
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence       Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("EvidenceRevisionActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([evidenceId, revisionNumber])
  @@index([organizationId, evidenceId, createdAt])
  @@index([createdById])
}

model Notification {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  severity       NotificationSeverity
  title          String
  message        String                 @db.Text
  sourceType     NotificationSourceType
  sourceId       String?
  dedupeKey      String
  actionHref     String?
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, userId, dismissedAt, readAt])
  @@index([organizationId, type, sourceType, sourceId])
  @@index([organizationId, severity, createdAt])
}

model DataControlJob {
  id             String               @id @default(cuid())
  organizationId String
  requestedById  String
  type           DataControlJobType
  status         DataControlJobStatus @default(PENDING)
  attemptCount   Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  activeKey      String?              @unique
  blobKey        String?
  resultSummary  Json?
  errorCode      String?
  createdAt      DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  requestedBy    User                 @relation("DataControlJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, type, status])
  @@index([status, nextAttemptAt, createdAt])
  @@index([requestedById, createdAt])
  @@index([blobKey])
}

model OrganizationMembership {
  id                String                                @id @default(cuid())
  organizationId    String
  userId            String                                @unique
  role              OrganizationRole
  preset            OrganizationAccessPreset?
  permissionKeys    String[]                              @default([])
  scopeMode         OrganizationScopeMode                 @default(ASSIGNED)
  expiresAt         DateTime?
  accessVersion     Int                                   @default(1)
  accessUpdatedById String?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt
  revokedAt         DateTime?
  organization      Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessUpdatedBy   User?                                 @relation("MembershipAccessUpdater", fields: [accessUpdatedById], references: [id], onDelete: SetNull)
  resourceGrants    OrganizationMembershipResourceGrant[]

  @@index([organizationId, role, revokedAt])
  @@index([accessUpdatedById, updatedAt])
}

model OrganizationInvitation {
  id                String                                @id @default(cuid())
  organizationId    String
  workerId          String?
  email             String
  recipientName     String?
  message           String?
  role              OrganizationRole
  preset            OrganizationAccessPreset?
  permissionKeys    String[]                              @default([])
  scopeMode         OrganizationScopeMode                 @default(ASSIGNED)
  tokenHash         String                                @unique
  activeKey         String?                               @unique
  invitedById       String
  expiresAt         DateTime
  acceptedAt        DateTime?
  declinedAt        DateTime?
  revokedAt         DateTime?
  accessExpiresAt   DateTime?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @default(now()) @updatedAt
  accessVersion     Int                                   @default(1)
  accessUpdatedById String?
  organization      Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker            Worker?                               @relation(fields: [workerId], references: [id], onDelete: SetNull)
  invitedBy         User                                  @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  accessUpdatedBy   User?                                 @relation("InvitationAccessUpdater", fields: [accessUpdatedById], references: [id], onDelete: SetNull)
  resourceGrants    OrganizationInvitationResourceGrant[]

  @@index([organizationId, email, createdAt])
  @@index([organizationId, workerId, createdAt])
  @@index([email, expiresAt])
  @@index([accessUpdatedById, updatedAt])
}

model OrganizationMembershipResourceGrant {
  id             String                   @id @default(cuid())
  organizationId String
  membershipId   String
  resourceType   OrganizationResourceType
  resourceId     String
  grantedById    String?
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  grantedBy      User?                    @relation("MembershipResourceGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([membershipId, resourceType, resourceId], map: "OrganizationMembershipResourceGrant_membershipId_resourceType_r")
  @@index([organizationId, resourceType, resourceId], map: "OrganizationMembershipResourceGrant_organizationId_resourceType")
}

model OrganizationInvitationResourceGrant {
  id             String                   @id @default(cuid())
  organizationId String
  invitationId   String
  resourceType   OrganizationResourceType
  resourceId     String
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitation     OrganizationInvitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, resourceType, resourceId], map: "OrganizationInvitationResourceGrant_invitationId_resourceType_r")
  @@index([organizationId, resourceType, resourceId], map: "OrganizationInvitationResourceGrant_organizationId_resourceType")
}

model SupportSession {
  id                      String              @id @default(cuid())
  actorId                 String
  organizationId          String
  tokenHash               String              @unique
  reason                  String
  expiresAt               DateTime
  sensitiveConfirmedUntil DateTime?
  endedAt                 DateTime?
  createdAt               DateTime            @default(now())
  actor                   User                @relation("SupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents             SupportAuditEvent[]
  productAuditEvents      ProductAuditEvent[]

  @@index([actorId, endedAt, expiresAt])
  @@index([organizationId, createdAt])
}

model SupportAuditEvent {
  id               String             @id @default(cuid())
  supportSessionId String
  actorId          String
  organizationId   String
  action           SupportAuditAction
  resourceType     String
  resourceId       String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  supportSession   SupportSession     @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  actor            User               @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([supportSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model ProductAuditEvent {
  id               String            @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorRole        OrganizationRole?
  action           AuditAction
  entityType       AuditEntityType
  entityId         String?
  outcome          AuditOutcome
  metadata         Json?
  requestId        String?
  supportSessionId String?
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor            User?             @relation("ProductAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  supportSession   SupportSession?   @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId, createdAt], map: "ProductAuditEvent_org_entity_entityId_created_idx")
  @@index([organizationId, outcome, createdAt])
  @@index([actorUserId, createdAt])
  @@index([supportSessionId, createdAt])
}

model UserCredential {
  userId                String   @id
  passwordHash          String
  passwordUpdatedAt     DateTime @default(now())
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id          String          @id @default(cuid())
  userId      String?
  email       String
  purpose     AuthCodePurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model MfaRecoveryRequest {
  id              String            @id @default(cuid())
  userId          String
  organizationId  String?
  mode            MfaRecoveryMode
  status          MfaRecoveryStatus @default(PENDING)
  activeKey       String?           @unique
  emailVerifiedAt DateTime
  expiresAt       DateTime
  approvedById    String?
  approvedAt      DateTime?
  deniedById      String?
  deniedAt        DateTime?
  setupStartedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("MfaRecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy      User?             @relation("MfaRecoveryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deniedBy        User?             @relation("MfaRecoveryDenier", fields: [deniedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([approvedById, approvedAt])
  @@index([deniedById, deniedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  bucket    String
  userId    String?
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bucket, resetAt])
  @@index([userId, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model RuntimeErrorEvent {
  id              String             @id @default(cuid())
  fingerprint     String             @unique
  status          RuntimeErrorStatus @default(OPEN)
  source          String
  routePath       String?
  requestMethod   String?
  errorName       String
  message         String
  stackPreview    String?            @db.Text
  digest          String?
  lastRequestId   String?
  occurrenceCount Int                @default(1)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNote  String?
  resolvedBy      User?              @relation("RuntimeErrorResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
  @@index([source, lastSeenAt])
  @@index([resolvedById, resolvedAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
