generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  START
  PRO
  ENTERPRISE
}

enum RecipeCategory {
  ANTIPASTO
  PRIMO
  SECONDO
  CONTORNO
  DOLCE
  PANE_LIEVITATI
  SALSA_BASE
  BEVANDA
  ALTRO
}

enum RecipeStatus {
  DRAFT
  READY
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum IngredientVerificationStatus {
  VERIFIED
  SUGGESTED
  PENDING_REVIEW
  REJECTED
}

enum IngredientSource {
  USER
  QOOVEX
  OPEN_FOOD_FACTS
  USDA
  OLLAMA
}

model User {
  id                  String             @id @default(cuid())
  clerkId             String             @unique
  name                String
  username            String             @unique
  email               String             @unique
  phoneNumber         String?
  imageUrl            String?
  plan                Plan               @default(FREE)
  recipes             Recipe[]
  menus               Menu[]
  shoppingLists       ShoppingList[]
  workPlans           WorkPlan[]         @relation("WorkPlanCreator")
  workPlanMemberships WorkPlanMember[]
  notifications       Notification[]
  recentSearches      RecentSearch[]
  ingredientReviews   IngredientReview[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, createdAt])
}

model Recipe {
  id                String             @id @default(cuid())
  title             String
  description       String?
  instructions      String?
  category          RecipeCategory     @default(ALTRO)
  status            RecipeStatus       @default(DRAFT)
  servings          Int                @default(4)
  prepTime          Int?
  cookTime          Int?
  imageUrl          String?
  isPublic          Boolean            @default(false)
  totalCalories     Float?
  totalCaloriesMin  Float?
  totalCaloriesMax  Float?
  totalProteins     Float?
  totalProteinsMin  Float?
  totalProteinsMax  Float?
  totalCarbs        Float?
  totalCarbsMin     Float?
  totalCarbsMax     Float?
  totalSugarsMin    Float?
  totalSugarsMax    Float?
  totalFats         Float?
  totalFatsMin      Float?
  totalFatsMax      Float?
  totalFiberMin     Float?
  totalFiberMax     Float?
  totalSaltMin      Float?
  totalSaltMax      Float?
  deletedAt         DateTime?
  authorId          String
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients       RecipeIngredient[]
  menuItems         MenuItem[]
  workTasks         WorkTask[]
  ingredientReviews IngredientReview[]
  likesCount        Int                @default(0)
  forkedFromId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([authorId, deletedAt, updatedAt])
  @@index([authorId, category, status])
  @@index([isPublic, status, updatedAt])
}

model Ingredient {
  id                 String                       @id @default(cuid())
  name               String                       @unique
  slug               String                       @unique
  sourceName         String?
  aliases            String[]                     @default([])
  allergens          String[]
  calories           Float?
  caloriesMin        Float?
  caloriesMax        Float?
  proteins           Float?
  proteinsMin        Float?
  proteinsMax        Float?
  carbs              Float?
  carbsMin           Float?
  carbsMax           Float?
  sugarsMin          Float?
  sugarsMax          Float?
  fats               Float?
  fatsMin            Float?
  fatsMax            Float?
  fiberMin           Float?
  fiberMax           Float?
  saltMin            Float?
  saltMax            Float?
  source             IngredientSource             @default(USER)
  sourceRef          String?
  confidence         Float?
  verificationStatus IngredientVerificationStatus @default(VERIFIED)
  sourceUpdatedAt    DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  recipes            RecipeIngredient[]
  reviews            IngredientReview[]

  @@index([slug])
  @@index([verificationStatus, updatedAt])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model IngredientReview {
  id             String                       @id @default(cuid())
  ingredientId   String?
  recipeId       String?
  userId         String
  rawName        String
  normalizedSlug String
  status         IngredientVerificationStatus @default(PENDING_REVIEW)
  note           String?
  resolvedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  ingredient     Ingredient?                  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe         Recipe?                      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([normalizedSlug, userId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Menu {
  id          String     @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean    @default(false)
  qrCodeUrl   String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  recipeId String
  position Int
  section  String?
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipe   Recipe  @relation(fields: [recipeId], references: [id])

  @@unique([menuId, position])
}

model ShoppingList {
  id        String             @id @default(cuid())
  title     String
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  name           String
  quantity       Float
  unit           String
  checked        Boolean      @default(false)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

model WorkPlan {
  id          String           @id @default(cuid())
  title       String
  description String?
  creatorId   String
  creator     User             @relation("WorkPlanCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     WorkPlanMember[]
  tasks       WorkTask[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model WorkPlanMember {
  id         String   @id @default(cuid())
  workPlanId String
  userId     String
  joinedAt   DateTime @default(now())
  workPlan   WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workPlanId, userId])
}

model WorkTask {
  id             String    @id @default(cuid())
  workPlanId     String
  title          String
  description    String?
  recipeId       String?
  recipeSnapshot Json?
  completedAt    DateTime?
  completedBy    String?
  position       Int
  workPlan       WorkPlan  @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  recipe         Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  data      Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
