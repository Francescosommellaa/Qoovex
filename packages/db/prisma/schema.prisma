}

model JobSiteExportDownloadGrant {
  id         String        @id @default(cuid())
  exportId   String
  userId     String
  tokenHash  String        @unique
  activeKey  String?       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  export     JobSiteExport @relation(fields: [exportId], references: [id], onDelete: Restrict)

  @@index([exportId, userId, expiresAt])
}

model LegalHold {
  id               String          @id @default(cuid())
  organizationId   String
  jobSiteId        String
  status           LegalHoldStatus @default(ACTIVE)
  reason           String          @db.Text
  placedByUserId   String
  placedAt         DateTime        @default(now())
  releasedByUserId String?
  releasedAt       DateTime?
  releaseReason    String?         @db.Text
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobSite          JobSite         @relation(fields: [jobSiteId], references: [id], onDelete: Restrict)

  @@index([organizationId, jobSiteId, status])
}

model JobSiteActionReceipt {
  id                 String       @id @default(cuid())
  organizationId     String
  jobSiteId          String
  action             String
  idempotencyKey     String
  inputFingerprint   String
  result             Json
  resultFingerprint  String
  actorUserId        String
  actorParticipantId String?
  expectedRevision   Int
  resultingRevision  Int
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobSite            JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Restrict)

  @@unique([organizationId, action, idempotencyKey])
  @@index([jobSiteId, createdAt])
}

model JobSiteProcess {
  id               String                @id @default(cuid())
  organizationId   String
  jobSiteId        String
  definitionKey    String
  status           JobSiteProcessStatus  @default(PENDING)
  activeKey        String?               @unique
  input            Json
  inputFingerprint String
  attemptCount     Int                   @default(0)
  maxAttempts      Int                   @default(3)
  nextAttemptAt    DateTime              @default(now())
  claimedBy        String?
  leaseExpiresAt   DateTime?
  fencingToken     BigInt                @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completedAt      DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobSite          JobSite               @relation(fields: [jobSiteId], references: [id], onDelete: Restrict)
  steps            JobSiteProcessStep[]
  events           JobSiteProcessEvent[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([organizationId, jobSiteId, definitionKey, status])
}

model JobSiteProcessStep {
  id           String                   @id @default(cuid())
  processId    String
  key          String
  ordinal      Int
  status       JobSiteProcessStepStatus @default(PENDING)
  attemptCount Int                      @default(0)
  input        Json?
  output       Json?
  errorCode    String?
  startedAt    DateTime?
  completedAt  DateTime?
  process      JobSiteProcess           @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([processId, key])
  @@unique([processId, ordinal])
}

model JobSiteProcessEvent {
  id           String                  @id @default(cuid())
  processId    String
  sequence     Int
  type         JobSiteProcessEventType
  payload      Json?
  fencingToken BigInt?
  createdAt    DateTime                @default(now())
  process      JobSiteProcess          @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@unique([processId, sequence])
  @@index([processId, createdAt])
}

model NotificationPreference {
  id             String                @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  channel        NotificationChannel
  frequency      NotificationFrequency @default(IMMEDIATE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, type, channel])
  @@index([userId, channel])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  organizationId String
  userId         String
  notificationId String?
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  dedupeKey      String                     @unique
  templateKey    String
  safePayload    Json
  attemptCount   Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  sentAt         DateTime?
  failedAt       DateTime?
  errorCode      String?
  createdAt      DateTime                   @default(now())
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, createdAt])
  @@index([organizationId, userId, status])
}

model OrganizationMembership {
  id                String                                @id @default(cuid())
  organizationId    String
  userId            String
  role              OrganizationRole
  preset            OrganizationAccessPreset?
  permissionKeys    String[]                              @default([])
  scopeMode         OrganizationScopeMode                 @default(ASSIGNED)
  expiresAt         DateTime?
  accessVersion     Int                                   @default(1)
  accessUpdatedById String?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt
  revokedAt         DateTime?
  organization      Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessUpdatedBy   User?                                 @relation("MembershipAccessUpdater", fields: [accessUpdatedById], references: [id], onDelete: SetNull)
  resourceGrants    OrganizationMembershipResourceGrant[]
  participants      JobSiteParticipant[]

  @@unique([organizationId, userId])
  @@index([organizationId, role, revokedAt])
  @@index([userId, revokedAt])
  @@index([accessUpdatedById, updatedAt])
}

model OrganizationInvitation {
  id                String                                @id @default(cuid())
  organizationId    String
  workerId          String?
  email             String
  recipientName     String?
  message           String?
  role              OrganizationRole
  preset            OrganizationAccessPreset?
  permissionKeys    String[]                              @default([])
  scopeMode         OrganizationScopeMode                 @default(ASSIGNED)
  tokenHash         String                                @unique
  activeKey         String?                               @unique
  invitedById       String
  expiresAt         DateTime
  acceptedAt        DateTime?
  declinedAt        DateTime?
  revokedAt         DateTime?
  accessExpiresAt   DateTime?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @default(now()) @updatedAt
  accessVersion     Int                                   @default(1)
  accessUpdatedById String?
  organization      Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker            Worker?                               @relation(fields: [workerId], references: [id], onDelete: SetNull)
  invitedBy         User                                  @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  accessUpdatedBy   User?                                 @relation("InvitationAccessUpdater", fields: [accessUpdatedById], references: [id], onDelete: SetNull)
  resourceGrants    OrganizationInvitationResourceGrant[]

  @@index([organizationId, email, createdAt])
  @@index([organizationId, workerId, createdAt])
  @@index([email, expiresAt])
  @@index([accessUpdatedById, updatedAt])
}

model OrganizationMembershipResourceGrant {
  id             String                   @id @default(cuid())
  organizationId String
  membershipId   String
  resourceType   OrganizationResourceType
  resourceId     String
  grantedById    String?
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  grantedBy      User?                    @relation("MembershipResourceGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([membershipId, resourceType, resourceId], map: "OrganizationMembershipResourceGrant_membershipId_resourceType_r")
  @@index([organizationId, resourceType, resourceId], map: "OrganizationMembershipResourceGrant_organizationId_resourceType")
}

model OrganizationInvitationResourceGrant {
  id             String                   @id @default(cuid())
  organizationId String
  invitationId   String
  resourceType   OrganizationResourceType
  resourceId     String
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitation     OrganizationInvitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, resourceType, resourceId], map: "OrganizationInvitationResourceGrant_invitationId_resourceType_r")
  @@index([organizationId, resourceType, resourceId], map: "OrganizationInvitationResourceGrant_organizationId_resourceType")
}

model SupportSession {
  id                      String              @id @default(cuid())
  actorId                 String
  organizationId          String
  tokenHash               String              @unique
  reason                  String
  expiresAt               DateTime
  sensitiveConfirmedUntil DateTime?
  endedAt                 DateTime?
  createdAt               DateTime            @default(now())
  actor                   User                @relation("SupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents             SupportAuditEvent[]
  productAuditEvents      ProductAuditEvent[]

  @@index([actorId, endedAt, expiresAt])
  @@index([organizationId, createdAt])
}

model SupportAuditEvent {
  id               String             @id @default(cuid())
  supportSessionId String
  actorId          String
  organizationId   String
  action           SupportAuditAction
  resourceType     String
  resourceId       String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  supportSession   SupportSession     @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  actor            User               @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([supportSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model ProductAuditEvent {
  id               String            @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorRole        OrganizationRole?
  action           AuditAction
  entityType       AuditEntityType
  entityId         String?
  outcome          AuditOutcome
  metadata         Json?
  requestId        String?
  supportSessionId String?
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor            User?             @relation("ProductAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  supportSession   SupportSession?   @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId, createdAt], map: "ProductAuditEvent_org_entity_entityId_created_idx")
  @@index([organizationId, outcome, createdAt])
  @@index([actorUserId, createdAt])
  @@index([supportSessionId, createdAt])
}

model UserCredential {
  userId                String   @id
  passwordHash          String
  passwordUpdatedAt     DateTime @default(now())
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id          String          @id @default(cuid())
  userId      String?
  email       String
  purpose     AuthCodePurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model MfaRecoveryRequest {
  id              String            @id @default(cuid())
  userId          String
  organizationId  String?
  mode            MfaRecoveryMode
  status          MfaRecoveryStatus @default(PENDING)
  activeKey       String?           @unique
  emailVerifiedAt DateTime
  expiresAt       DateTime
  approvedById    String?
  approvedAt      DateTime?
  deniedById      String?
  deniedAt        DateTime?
  setupStartedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("MfaRecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy      User?             @relation("MfaRecoveryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deniedBy        User?             @relation("MfaRecoveryDenier", fields: [deniedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([approvedById, approvedAt])
  @@index([deniedById, deniedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  bucket    String
  userId    String?
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bucket, resetAt])
  @@index([userId, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model RuntimeErrorEvent {
  id              String             @id @default(cuid())
  fingerprint     String             @unique
  status          RuntimeErrorStatus @default(OPEN)
  source          String
  routePath       String?
  requestMethod   String?
  errorName       String
  message         String
  stackPreview    String?            @db.Text
  digest          String?
  lastRequestId   String?
  occurrenceCount Int                @default(1)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNote  String?
  resolvedBy      User?              @relation("RuntimeErrorResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
  @@index([source, lastSeenAt])
  @@index([resolvedById, resolvedAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
