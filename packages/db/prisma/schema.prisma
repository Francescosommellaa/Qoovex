  id             String                   @id @default(cuid())
  organizationId String
  membershipId   String
  resourceType   OrganizationResourceType
  resourceId     String
  grantedById    String?
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  grantedBy      User?                    @relation("MembershipResourceGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([membershipId, resourceType, resourceId], map: "OrganizationMembershipResourceGrant_membershipId_resourceType_r")
  @@index([organizationId, resourceType, resourceId], map: "OrganizationMembershipResourceGrant_organizationId_resourceType")
}

model OrganizationInvitationResourceGrant {
  id             String                   @id @default(cuid())
  organizationId String
  invitationId   String
  resourceType   OrganizationResourceType
  resourceId     String
  createdAt      DateTime                 @default(now())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitation     OrganizationInvitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, resourceType, resourceId], map: "OrganizationInvitationResourceGrant_invitationId_resourceType_r")
  @@index([organizationId, resourceType, resourceId], map: "OrganizationInvitationResourceGrant_organizationId_resourceType")
}

model SupportSession {
  id                      String              @id @default(cuid())
  actorId                 String
  organizationId          String
  tokenHash               String              @unique
  reason                  String
  expiresAt               DateTime
  sensitiveConfirmedUntil DateTime?
  endedAt                 DateTime?
  createdAt               DateTime            @default(now())
  actor                   User                @relation("SupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents             SupportAuditEvent[]
  productAuditEvents      ProductAuditEvent[]

  @@index([actorId, endedAt, expiresAt])
  @@index([organizationId, createdAt])
}

model SupportAuditEvent {
  id               String             @id @default(cuid())
  supportSessionId String
  actorId          String
  organizationId   String
  action           SupportAuditAction
  resourceType     String
  resourceId       String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  supportSession   SupportSession     @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  actor            User               @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([supportSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model ProductAuditEvent {
  id               String            @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorRole        OrganizationRole?
  action           AuditAction
  entityType       AuditEntityType
  entityId         String?
  outcome          AuditOutcome
  metadata         Json?
  requestId        String?
  supportSessionId String?
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor            User?             @relation("ProductAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  supportSession   SupportSession?   @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId, createdAt], map: "ProductAuditEvent_org_entity_entityId_created_idx")
  @@index([organizationId, outcome, createdAt])
  @@index([actorUserId, createdAt])
  @@index([supportSessionId, createdAt])
}

model UserCredential {
  userId                String   @id
  passwordHash          String
  passwordUpdatedAt     DateTime @default(now())
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id          String          @id @default(cuid())
  userId      String?
  email       String
  purpose     AuthCodePurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model MfaRecoveryRequest {
  id              String            @id @default(cuid())
  userId          String
  organizationId  String?
  mode            MfaRecoveryMode
  status          MfaRecoveryStatus @default(PENDING)
  activeKey       String?           @unique
  emailVerifiedAt DateTime
  expiresAt       DateTime
  approvedById    String?
  approvedAt      DateTime?
  deniedById      String?
  deniedAt        DateTime?
  setupStartedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("MfaRecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy      User?             @relation("MfaRecoveryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deniedBy        User?             @relation("MfaRecoveryDenier", fields: [deniedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([approvedById, approvedAt])
  @@index([deniedById, deniedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  bucket    String
  userId    String?
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bucket, resetAt])
  @@index([userId, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model RuntimeErrorEvent {
  id              String             @id @default(cuid())
  fingerprint     String             @unique
  status          RuntimeErrorStatus @default(OPEN)
  source          String
  routePath       String?
  requestMethod   String?
  errorName       String
  message         String
  stackPreview    String?            @db.Text
  digest          String?
  lastRequestId   String?
  occurrenceCount Int                @default(1)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNote  String?
  resolvedBy      User?              @relation("RuntimeErrorResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
  @@index([source, lastSeenAt])
  @@index([resolvedById, resolvedAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
