generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  SAFETY_CONSULTANT
  SITE_MANAGER
  WORKER
  VIEWER
}

enum SupportAuditAction {
  READ
  WRITE
  SENSITIVE
  EXPORT
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PRESENT
  MISSING
  EXPIRED
  EXPIRING_SOON
  TO_REVIEW
  ARCHIVED
}

enum DeadlineStatus {
  SCHEDULED
  EXPIRING_SOON
  EXPIRED
  DONE
  ARCHIVED
}

enum ChecklistItemStatus {
  OPEN
  DONE
  TO_REVIEW
  ARCHIVED
}

enum DocumentPackageStatus {
  DRAFT
  READY_FOR_REVIEW
  SHARED
  ARCHIVED
}

enum DocumentOwnerType {
  ORGANIZATION
  WORKER
  JOB_SITE
}

enum DocumentTypeAppliesTo {
  ORGANIZATION
  WORKER
  JOB_SITE
  EVIDENCE
  OTHER
}

enum RequirementTargetType {
  ORGANIZATION
  WORKER
  JOB_SITE
}

enum DeadlineSourceType {
  DOCUMENT
  CHECKLIST
  MANUAL
  OTHER
}

enum EvidenceType {
  PHOTO
  FILE
  NOTE
}

enum DocumentPackageItemType {
  DOCUMENT
  DOCUMENT_VERSION
  EVIDENCE
  CHECKLIST
  NOTE
}

enum NotificationType {
  DEADLINE_OVERDUE
  DEADLINE_UPCOMING
  DOCUMENT_TO_REVIEW
  DOCUMENT_EXPIRED
  DOCUMENT_EXPIRING_SOON
  PACKAGE_READY_FOR_REVIEW
  SHARE_LINK_EXPIRING
  SHARE_LINK_REVOKED
  SYSTEM
}

enum NotificationSeverity {
  INFO
  ATTENTION
  WARNING
}

enum NotificationSourceType {
  DOCUMENT
  DEADLINE
  WORKER
  JOB_SITE
  CHECKLIST
  EVIDENCE
  DOCUMENT_PACKAGE
  SHARE_LINK
  SYSTEM
}

enum EmailDigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum NotificationEmailDeliveryType {
  DIGEST
  SINGLE_NOTIFICATION
}

enum NotificationEmailDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider           String
  providerAccountId String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                         String               @id @default(cuid())
  name                       String?
  email                      String               @unique
  emailVerified              DateTime?
  image                      String?
  firstName                  String               @default("")
  lastName                   String?
  username                   String               @unique
  usernameOnboarded          Boolean              @default(true)
  profileOnboarded           Boolean              @default(true)
  avatarBlobPathname         String?
  phoneNumber                String?
  platformRole               PlatformRole         @default(USER)
  authVersion                Int                  @default(1)
  accounts                   Account[]
  sessions                   Session[]
  credential                 UserCredential?
  authCodes                  AuthCode[]
  securityEvents             SecurityAuditEvent[]
  mfaEnabled                 Boolean              @default(false)
  totpSecretEncrypted        String?
  totpSecretNonce            String?
  totpPendingSecretEncrypted String?
  totpPendingSecretNonce     String?
  totpPendingCreatedAt       DateTime?
  totpVerifiedAt             DateTime?
  usernameChangedAt          DateTime?
  mfaBackupCodes             MfaBackupCode[]
  authDevices                AuthDevice[]
  organizationMemberships    OrganizationMembership[]
  createdOrganizations       Organization[]           @relation("OrganizationCreator")
  sentOrganizationInvitations OrganizationInvitation[] @relation("InvitationSender")
  supportSessions            SupportSession[]      @relation("SupportActor")
  supportAuditEvents         SupportAuditEvent[]   @relation("SupportAuditActor")
  reviewedDocuments          Document[]            @relation("DocumentReviewer")
  uploadedDocumentVersions   DocumentVersion[]     @relation("DocumentVersionUploader")
  completedChecklistItems    ChecklistItem[]       @relation("ChecklistItemCompleter")
  createdEvidence            Evidence[]            @relation("EvidenceCreator")
  createdDocumentPackages    DocumentPackage[]     @relation("DocumentPackageCreator")
  createdShareLinks          ShareLink[]           @relation("ShareLinkCreator")
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  notificationEmailDeliveries NotificationEmailDelivery[]
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
}

model Organization {
  id             String                @id @default(cuid())
  name           String
  code           String                @unique
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      User?                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    OrganizationMembership[]
  invitations    OrganizationInvitation[]
  supportSessions SupportSession[]
  supportEvents  SupportAuditEvent[]
  workers        Worker[]
  jobSites       JobSite[]
  documentTypes  DocumentType[]
  documents      Document[]
  documentVersions DocumentVersion[]
  documentRequirements DocumentRequirement[]
  deadlines      Deadline[]
  checklists     Checklist[]
  checklistItems ChecklistItem[]
  evidence       Evidence[]
  documentPackages DocumentPackage[]
  documentPackageItems DocumentPackageItem[]
  shareLinks     ShareLink[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]
  notificationEmailDeliveries NotificationEmailDelivery[]

  @@index([name])
}

model Worker {
  id             String       @id @default(cuid())
  organizationId String
  displayName    String
  email          String?
  phone          String?
  roleLabel      String?
  status         RecordStatus @default(ACTIVE)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  deadlines      Deadline[]
  evidence       Evidence[]

  @@index([organizationId, status])
  @@index([organizationId, displayName])
  @@index([organizationId, email])
}

model JobSite {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String?
  clientName     String?
  status         RecordStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]
  requirements   DocumentRequirement[]
  deadlines      Deadline[]
  checklists     Checklist[]
  evidence       Evidence[]
  documentPackages DocumentPackage[]

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, clientName])
}

model DocumentType {
  id                 String                @id @default(cuid())
  organizationId     String
  name               String
  description        String?               @db.Text
  appliesTo          DocumentTypeAppliesTo
  requiresExpiryDate Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  archivedAt         DateTime?
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          Document[]
  requirements       DocumentRequirement[]

  @@index([organizationId, appliesTo])
  @@index([organizationId, name])
}

model Document {
  id             String            @id @default(cuid())
  organizationId String
  documentTypeId String?
  ownerType      DocumentOwnerType
  workerId       String?
  jobSiteId      String?
  title          String
  status         DocumentStatus    @default(TO_REVIEW)
  expiryDate     DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   DocumentType?     @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  worker         Worker?           @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobSite        JobSite?          @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  reviewedBy     User?             @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]
  deadlines      Deadline[]
  packageItems   DocumentPackageItem[]

  @@index([organizationId, status])
  @@index([organizationId, ownerType])
  @@index([organizationId, workerId])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, documentTypeId])
  @@index([organizationId, expiryDate])
}

model DocumentVersion {
  id               String        @id @default(cuid())
  organizationId   String
  documentId       String
  blobKey          String
  originalFileName String
  mimeType         String
  size             Int
  checksum         String?
  uploadedById     String
  createdAt        DateTime      @default(now())
  archivedAt       DateTime?
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User          @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  packageItems     DocumentPackageItem[]

  @@index([organizationId, documentId, createdAt])
  @@index([organizationId, uploadedById])
  @@index([organizationId, blobKey])
}

model DocumentRequirement {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  description    String?               @db.Text
  targetType     RequirementTargetType
  documentTypeId String?
  jobSiteId      String?
  isRequired     Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   DocumentType?         @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)

  @@index([organizationId, targetType])
  @@index([organizationId, documentTypeId])
  @@index([organizationId, jobSiteId])
}

model Deadline {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  dueDate        DateTime
  sourceType     DeadlineSourceType
  documentId     String?
  workerId       String?
  jobSiteId      String?
  status         DeadlineStatus     @default(SCHEDULED)
  remindAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  archivedAt     DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  worker         Worker?            @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobSite        JobSite?           @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, documentId])
  @@index([organizationId, workerId])
  @@index([organizationId, jobSiteId])
}

model Checklist {
  id             String       @id @default(cuid())
  organizationId String
  jobSiteId      String?
  name           String
  description    String?      @db.Text
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite?     @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  items          ChecklistItem[]
  packageItems   DocumentPackageItem[]

  @@index([organizationId, status])
  @@index([organizationId, jobSiteId])
}

model ChecklistItem {
  id             String              @id @default(cuid())
  organizationId String
  checklistId    String
  label          String
  description    String?             @db.Text
  status         ChecklistItemStatus  @default(OPEN)
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklist      Checklist           @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy    User?               @relation("ChecklistItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  evidence       Evidence[]

  @@index([organizationId, checklistId])
  @@index([organizationId, status])
  @@index([organizationId, completedById])
}

model Evidence {
  id               String        @id @default(cuid())
  organizationId   String
  jobSiteId        String?
  workerId         String?
  checklistItemId  String?
  type             EvidenceType
  title            String
  description      String?       @db.Text
  blobKey          String?
  originalFileName String?
  mimeType         String?
  size             Int?
  createdById      String
  createdAt        DateTime      @default(now())
  archivedAt       DateTime?
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite          JobSite?      @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  worker           Worker?       @relation(fields: [workerId], references: [id], onDelete: SetNull)
  checklistItem    ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  createdBy        User          @relation("EvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  packageItems     DocumentPackageItem[]

  @@index([organizationId, type])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, workerId])
  @@index([organizationId, checklistItemId])
  @@index([organizationId, createdAt])
}

model DocumentPackage {
  id             String                @id @default(cuid())
  organizationId String
  jobSiteId      String?
  title          String
  description    String?               @db.Text
  status         DocumentPackageStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("DocumentPackageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          DocumentPackageItem[]
  shareLinks     ShareLink[]

  @@index([organizationId, status])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, createdById])
}

model DocumentPackageItem {
  id                String                  @id @default(cuid())
  organizationId    String
  documentPackageId String
  itemType          DocumentPackageItemType
  documentId        String?
  documentVersionId String?
  evidenceId        String?
  checklistId       String?
  note              String?                 @db.Text
  position          Int                     @default(0)
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentPackage   DocumentPackage         @relation(fields: [documentPackageId], references: [id], onDelete: Cascade)
  document          Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentVersion   DocumentVersion?        @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  evidence          Evidence?               @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  checklist         Checklist?              @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  @@index([organizationId, documentPackageId, position])
  @@index([organizationId, documentId])
  @@index([organizationId, documentVersionId])
  @@index([organizationId, evidenceId])
  @@index([organizationId, checklistId])
}

model ShareLink {
  id                String          @id @default(cuid())
  organizationId    String
  documentPackageId String
  tokenHash         String          @unique
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdById       String
  createdAt         DateTime        @default(now())
  lastAccessedAt    DateTime?
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentPackage   DocumentPackage @relation(fields: [documentPackageId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, documentPackageId])
  @@index([organizationId, revokedAt, expiresAt])
  @@index([organizationId, createdById])
}

model Notification {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  severity       NotificationSeverity
  title          String
  message        String                 @db.Text
  sourceType     NotificationSourceType
  sourceId       String?
  dedupeKey      String
  actionHref     String?
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDeliveries NotificationEmailDelivery[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, userId, dismissedAt, readAt])
  @@index([organizationId, type, sourceType, sourceId])
  @@index([organizationId, severity, createdAt])
}

model NotificationPreference {
  id                   String               @id @default(cuid())
  organizationId       String
  userId               String
  emailDigestEnabled   Boolean              @default(false)
  emailDigestFrequency EmailDigestFrequency @default(OFF)
  emailDigestHour      Int                  @default(8)
  lastDigestSentAt     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, emailDigestEnabled, emailDigestFrequency])
  @@index([userId, updatedAt])
}

model NotificationEmailDelivery {
  id                String                          @id @default(cuid())
  organizationId    String
  userId            String
  notificationId    String?
  type              NotificationEmailDeliveryType
  recipientEmail    String
  notificationCount Int                             @default(0)
  status            NotificationEmailDeliveryStatus
  providerMessageId String?
  errorCode         String?
  sentAt            DateTime?
  createdAt         DateTime                        @default(now())
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification      Notification?                   @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([notificationId])
}

model OrganizationMembership {
  id          String        @id @default(cuid())
  organizationId String
  userId      String
  role        OrganizationRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  revokedAt   DateTime?
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, revokedAt])
  @@index([organizationId, role, revokedAt])
}

model OrganizationInvitation {
  id          String        @id @default(cuid())
  organizationId String
  email       String
  role        OrganizationRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@index([email, expiresAt])
}

model SupportSession {
  id                     String              @id @default(cuid())
  actorId                String
  organizationId         String
  tokenHash              String              @unique
  reason                 String
  expiresAt              DateTime
  sensitiveConfirmedUntil DateTime?
  endedAt                DateTime?
  createdAt              DateTime            @default(now())
  actor                  User                @relation("SupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents            SupportAuditEvent[]

  @@index([actorId, endedAt, expiresAt])
  @@index([organizationId, createdAt])
}

model SupportAuditEvent {
  id               String             @id @default(cuid())
  supportSessionId String
  actorId          String
  organizationId   String
  action           SupportAuditAction
  resourceType     String
  resourceId       String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  supportSession   SupportSession     @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  actor            User               @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([supportSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model UserCredential {
  userId                String   @id
  passwordHash          String
  passwordUpdatedAt     DateTime @default(now())
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id          String          @id @default(cuid())
  userId      String?
  email       String
  purpose     AuthCodePurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key     String   @id
  bucket  String
  count   Int      @default(0)
  resetAt DateTime

  @@index([bucket, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
