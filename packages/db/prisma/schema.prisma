generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  MFA_ENROLLMENT
  MFA_RECOVERY
}

enum MfaRecoveryMode {
  SELF_EMAIL
  OWNER_APPROVAL
}

enum MfaRecoveryStatus {
  PENDING
  APPROVED
  DENIED
  SETUP_STARTED
  COMPLETED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  SAFETY_CONSULTANT
  SITE_MANAGER
  WORKER
}

enum SupportAuditAction {
  READ
  WRITE
  SENSITIVE
  EXPORT
}

enum AuditAction {
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_ARCHIVED
  DOCUMENT_VERSION_UPLOADED
  DOCUMENT_VERSION_DOWNLOADED
  DOCUMENT_VERSION_ARCHIVED
  DEADLINE_CREATED
  DEADLINE_UPDATED
  DEADLINE_ARCHIVED
  WORKER_CREATED
  WORKER_UPDATED
  WORKER_ARCHIVED
  JOB_SITE_CREATED
  JOB_SITE_UPDATED
  JOB_SITE_ARCHIVED
  CHECKLIST_CREATED
  CHECKLIST_UPDATED
  CHECKLIST_ARCHIVED
  CHECKLIST_ITEM_COMPLETED
  EVIDENCE_CREATED
  EVIDENCE_DOWNLOADED
  EVIDENCE_ARCHIVED
  DOCUMENT_PACKAGE_CREATED
  DOCUMENT_PACKAGE_UPDATED
  DOCUMENT_PACKAGE_ARCHIVED
  DOCUMENT_PACKAGE_ITEM_ADDED
  DOCUMENT_PACKAGE_ITEM_REMOVED
  SHARE_LINK_CREATED
  SHARE_LINK_REVOKED
  SHARE_LINK_ACCESSED
  NOTIFICATION_READ
  NOTIFICATION_DISMISSED
  EMAIL_DIGEST_SENT
  EMAIL_DIGEST_FAILED
  NOTIFICATION_PREFERENCES_UPDATED
  SCHEDULED_EMAIL_DIGEST_RUN
  WORKER_USER_LINK_CREATED
  WORKER_USER_LINK_ARCHIVED
  JOB_SITE_USER_ASSIGNMENT_CREATED
  JOB_SITE_USER_ASSIGNMENT_ARCHIVED
  JOB_SITE_WORKER_ASSIGNMENT_CREATED
  JOB_SITE_WORKER_ASSIGNMENT_ARCHIVED
  DATA_EXPORT_GENERATED
  DATA_EXPORT_FAILED
  DATA_CONTROL_JOB_CREATED
  DATA_CONTROL_JOB_RUN
  ORPHAN_BLOB_CLEANUP_RUN
  ORGANIZATION_DELETE_REQUESTED
  ORGANIZATION_DELETE_RUN
  DOCUMENT_REQUIREMENT_CREATED
  DOCUMENT_REQUIREMENT_UPDATED
  DOCUMENT_REQUIREMENT_ARCHIVED
  SECURITY_DENIED
}

enum AuditEntityType {
  DOCUMENT
  DOCUMENT_VERSION
  DEADLINE
  WORKER
  JOB_SITE
  CHECKLIST
  CHECKLIST_ITEM
  EVIDENCE
  DOCUMENT_PACKAGE
  DOCUMENT_PACKAGE_ITEM
  SHARE_LINK
  NOTIFICATION
  EMAIL_DELIVERY
  NOTIFICATION_PREFERENCE
  DATA_CONTROL_JOB
  DOCUMENT_REQUIREMENT
  WORKER_USER_LINK
  JOB_SITE_USER_ASSIGNMENT
  JOB_SITE_WORKER_ASSIGNMENT
  ORGANIZATION
  USER
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentStatus {
  PRESENT
  MISSING
  EXPIRED
  EXPIRING_SOON
  TO_REVIEW
  ARCHIVED
}

enum DeadlineStatus {
  SCHEDULED
  EXPIRING_SOON
  EXPIRED
  DONE
  ARCHIVED
}

enum ChecklistItemStatus {
  OPEN
  DONE
  TO_REVIEW
  ARCHIVED
}

enum DocumentPackageStatus {
  DRAFT
  READY_FOR_REVIEW
  SHARED
  ARCHIVED
}

enum DocumentOwnerType {
  ORGANIZATION
  WORKER
  JOB_SITE
}

enum DocumentTypeAppliesTo {
  ORGANIZATION
  WORKER
  JOB_SITE
  EVIDENCE
  OTHER
}

enum RequirementTargetType {
  ORGANIZATION
  WORKER
  JOB_SITE
}

enum DeadlineSourceType {
  DOCUMENT
  CHECKLIST
  MANUAL
  OTHER
}

enum EvidenceType {
  PHOTO
  FILE
  NOTE
}

enum DocumentPackageItemType {
  DOCUMENT
  DOCUMENT_VERSION
  EVIDENCE
  CHECKLIST
  NOTE
}

enum NotificationType {
  DEADLINE_OVERDUE
  DEADLINE_UPCOMING
  DOCUMENT_TO_REVIEW
  DOCUMENT_EXPIRED
  DOCUMENT_EXPIRING_SOON
  PACKAGE_READY_FOR_REVIEW
  SHARE_LINK_EXPIRING
  SHARE_LINK_REVOKED
  SYSTEM
}

enum NotificationSeverity {
  INFO
  ATTENTION
  WARNING
}

enum NotificationSourceType {
  DOCUMENT
  DEADLINE
  WORKER
  JOB_SITE
  CHECKLIST
  EVIDENCE
  DOCUMENT_PACKAGE
  SHARE_LINK
  SYSTEM
}

enum EmailDigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum NotificationEmailDeliveryType {
  DIGEST
  SINGLE_NOTIFICATION
}

enum NotificationEmailDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum JobSiteUserAssignmentRole {
  SITE_MANAGER
}

enum DataControlJobType {
  METADATA_EXPORT
  ORGANIZATION_DELETE
  ORPHAN_BLOB_CLEANUP
}

enum DataControlJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RuntimeErrorStatus {
  OPEN
  RESOLVED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                          String                      @id @default(cuid())
  name                        String?
  email                       String                      @unique
  emailVerified               DateTime?
  image                       String?
  firstName                   String                      @default("")
  lastName                    String?
  username                    String                      @unique
  usernameOnboarded           Boolean                     @default(true)
  profileOnboarded            Boolean                     @default(true)
  avatarBlobPathname          String?
  phoneNumber                 String?
  platformRole                PlatformRole                @default(USER)
  authVersion                 Int                         @default(1)
  suspendedAt                 DateTime?
  suspensionReason            String?
  accounts                    Account[]
  sessions                    Session[]
  credential                  UserCredential?
  authCodes                   AuthCode[]
  authRateLimits              AuthRateLimit[]
  securityEvents              SecurityAuditEvent[]
  mfaEnabled                  Boolean                     @default(false)
  totpSecretEncrypted         String?
  totpSecretNonce             String?
  totpPendingSecretEncrypted  String?
  totpPendingSecretNonce      String?
  totpPendingCreatedAt        DateTime?
  totpVerifiedAt              DateTime?
  usernameChangedAt           DateTime?
  mfaBackupCodes              MfaBackupCode[]
  mfaRecoveryRequests         MfaRecoveryRequest[]        @relation("MfaRecoverySubject")
  approvedMfaRecoveries       MfaRecoveryRequest[]        @relation("MfaRecoveryApprover")
  deniedMfaRecoveries         MfaRecoveryRequest[]        @relation("MfaRecoveryDenier")
  authDevices                 AuthDevice[]
  organizationMembership      OrganizationMembership?
  createdOrganizations        Organization[]              @relation("OrganizationCreator")
  sentOrganizationInvitations OrganizationInvitation[]    @relation("InvitationSender")
  supportSessions             SupportSession[]            @relation("SupportActor")
  supportAuditEvents          SupportAuditEvent[]         @relation("SupportAuditActor")
  productAuditEvents          ProductAuditEvent[]         @relation("ProductAuditActor")
  reviewedDocuments           Document[]                  @relation("DocumentReviewer")
  uploadedDocumentVersions    DocumentVersion[]           @relation("DocumentVersionUploader")
  completedChecklistItems     ChecklistItem[]             @relation("ChecklistItemCompleter")
  createdEvidence             Evidence[]                  @relation("EvidenceCreator")
  createdDocumentPackages     DocumentPackage[]           @relation("DocumentPackageCreator")
  createdShareLinks           ShareLink[]                 @relation("ShareLinkCreator")
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  notificationEmailDeliveries NotificationEmailDelivery[]
  requestedDataControlJobs    DataControlJob[]            @relation("DataControlJobRequester")
  resolvedRuntimeErrors       RuntimeErrorEvent[]         @relation("RuntimeErrorResolver")
  workerUserLinks             WorkerUserLink[]
  linkedWorkerUserLinks       WorkerUserLink[]            @relation("WorkerUserLinkCreator")
  jobSiteUserAssignments      JobSiteUserAssignment[]
  assignedJobSiteUsers        JobSiteUserAssignment[]     @relation("JobSiteUserAssignmentCreator")
  assignedJobSiteWorkers      JobSiteWorkerAssignment[]   @relation("JobSiteWorkerAssignmentCreator")
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
}

model Organization {
  id                          String                      @id @default(cuid())
  name                        String
  code                        String                      @unique
  createdById                 String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  createdBy                   User?                       @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships                 OrganizationMembership[]
  invitations                 OrganizationInvitation[]
  supportSessions             SupportSession[]
  supportEvents               SupportAuditEvent[]
  productAuditEvents          ProductAuditEvent[]
  mfaRecoveryRequests         MfaRecoveryRequest[]
  workers                     Worker[]
  jobSites                    JobSite[]
  documentTypes               DocumentType[]
  documents                   Document[]
  documentVersions            DocumentVersion[]
  documentRequirements        DocumentRequirement[]
  deadlines                   Deadline[]
  checklists                  Checklist[]
  checklistItems              ChecklistItem[]
  evidence                    Evidence[]
  documentPackages            DocumentPackage[]
  documentPackageItems        DocumentPackageItem[]
  shareLinks                  ShareLink[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  notificationEmailDeliveries NotificationEmailDelivery[]
  workerUserLinks             WorkerUserLink[]
  jobSiteUserAssignments      JobSiteUserAssignment[]
  jobSiteWorkerAssignments    JobSiteWorkerAssignment[]

  @@index([name])
}

model Worker {
  id                 String                    @id @default(cuid())
  organizationId     String
  displayName        String
  email              String?
  phone              String?
  roleLabel          String?
  status             RecordStatus              @default(ACTIVE)
  notes              String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  archivedAt         DateTime?
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          Document[]
  deadlines          Deadline[]
  evidence           Evidence[]
  userLinks          WorkerUserLink[]
  jobSiteAssignments JobSiteWorkerAssignment[]

  @@index([organizationId, status])
  @@index([organizationId, displayName])
  @@index([organizationId, email])
}

model JobSite {
  id                String                    @id @default(cuid())
  organizationId    String
  name              String
  address           String?
  clientName        String?
  status            RecordStatus              @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?                   @db.Text
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents         Document[]
  requirements      DocumentRequirement[]
  deadlines         Deadline[]
  checklists        Checklist[]
  evidence          Evidence[]
  documentPackages  DocumentPackage[]
  userAssignments   JobSiteUserAssignment[]
  workerAssignments JobSiteWorkerAssignment[]

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, clientName])
}

model WorkerUserLink {
  id             String       @id @default(cuid())
  organizationId String
  workerId       String
  userId         String
  linkedById     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedBy       User         @relation("WorkerUserLinkCreator", fields: [linkedById], references: [id], onDelete: Restrict)

  @@index([organizationId, workerId, archivedAt])
  @@index([organizationId, userId, archivedAt])
  @@index([organizationId, createdAt])
  @@index([linkedById])
}

model JobSiteUserAssignment {
  id             String                    @id @default(cuid())
  organizationId String
  jobSiteId      String
  userId         String
  assignmentRole JobSiteUserAssignmentRole @default(SITE_MANAGER)
  assignedById   String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  archivedAt     DateTime?
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite                   @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User                      @relation("JobSiteUserAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, jobSiteId, assignmentRole, archivedAt], map: "JobSiteUserAssignment_org_job_role_archived_idx")
  @@index([organizationId, userId, assignmentRole, archivedAt], map: "JobSiteUserAssignment_org_user_role_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
}

model JobSiteWorkerAssignment {
  id             String       @id @default(cuid())
  organizationId String
  jobSiteId      String
  workerId       String
  assignedById   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy     User         @relation("JobSiteWorkerAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, jobSiteId, archivedAt], map: "JobSiteWorkerAssignment_org_job_archived_idx")
  @@index([organizationId, workerId, archivedAt], map: "JobSiteWorkerAssignment_org_worker_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
}

model DocumentType {
  id                 String                @id @default(cuid())
  organizationId     String
  name               String
  description        String?               @db.Text
  appliesTo          DocumentTypeAppliesTo
  requiresExpiryDate Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  archivedAt         DateTime?
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          Document[]
  requirements       DocumentRequirement[]

  @@index([organizationId, appliesTo])
  @@index([organizationId, name])
}

model Document {
  id             String                @id @default(cuid())
  organizationId String
  documentTypeId String?
  ownerType      DocumentOwnerType
  workerId       String?
  jobSiteId      String?
  title          String
  status         DocumentStatus        @default(TO_REVIEW)
  expiryDate     DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   DocumentType?         @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  worker         Worker?               @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  reviewedBy     User?                 @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]
  deadlines      Deadline[]
  packageItems   DocumentPackageItem[]

  @@index([organizationId, status])
  @@index([organizationId, ownerType])
  @@index([organizationId, workerId])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, documentTypeId])
  @@index([organizationId, expiryDate])
}

model DocumentVersion {
  id               String                @id @default(cuid())
  organizationId   String
  documentId       String
  blobKey          String
  originalFileName String
  mimeType         String
  size             Int
  checksum         String?
  uploadedById     String
  createdAt        DateTime              @default(now())
  archivedAt       DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         Document              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User                  @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  packageItems     DocumentPackageItem[]

  @@index([organizationId, documentId, createdAt])
  @@index([organizationId, uploadedById])
  @@index([organizationId, blobKey])
}

model DocumentRequirement {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  description    String?               @db.Text
  targetType     RequirementTargetType
  documentTypeId String?
  jobSiteId      String?
  isRequired     Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   DocumentType?         @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)

  @@index([organizationId, targetType])
  @@index([organizationId, documentTypeId])
  @@index([organizationId, jobSiteId])
}

model Deadline {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  dueDate        DateTime
  sourceType     DeadlineSourceType
  documentId     String?
  workerId       String?
  jobSiteId      String?
  status         DeadlineStatus     @default(SCHEDULED)
  remindAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  archivedAt     DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  worker         Worker?            @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobSite        JobSite?           @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, documentId])
  @@index([organizationId, workerId])
  @@index([organizationId, jobSiteId])
}

model Checklist {
  id             String                @id @default(cuid())
  organizationId String
  jobSiteId      String?
  name           String
  description    String?               @db.Text
  status         RecordStatus          @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  items          ChecklistItem[]
  packageItems   DocumentPackageItem[]

  @@index([organizationId, status])
  @@index([organizationId, jobSiteId])
}

model ChecklistItem {
  id             String              @id @default(cuid())
  organizationId String
  checklistId    String
  label          String
  description    String?             @db.Text
  status         ChecklistItemStatus @default(OPEN)
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checklist      Checklist           @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy    User?               @relation("ChecklistItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  evidence       Evidence[]

  @@index([organizationId, checklistId])
  @@index([organizationId, status])
  @@index([organizationId, completedById])
}

model Evidence {
  id               String                @id @default(cuid())
  organizationId   String
  jobSiteId        String?
  workerId         String?
  checklistItemId  String?
  type             EvidenceType
  title            String
  description      String?               @db.Text
  blobKey          String?
  originalFileName String?
  mimeType         String?
  size             Int?
  createdById      String
  createdAt        DateTime              @default(now())
  archivedAt       DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite          JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  worker           Worker?               @relation(fields: [workerId], references: [id], onDelete: SetNull)
  checklistItem    ChecklistItem?        @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  createdBy        User                  @relation("EvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  packageItems     DocumentPackageItem[]

  @@index([organizationId, type])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, workerId])
  @@index([organizationId, checklistItemId])
  @@index([organizationId, createdAt])
}

model DocumentPackage {
  id             String                @id @default(cuid())
  organizationId String
  jobSiteId      String?
  title          String
  description    String?               @db.Text
  status         DocumentPackageStatus @default(DRAFT)
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  createdBy      User                  @relation("DocumentPackageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items          DocumentPackageItem[]
  shareLinks     ShareLink[]

  @@index([organizationId, status])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, createdById])
}

model DocumentPackageItem {
  id                String                  @id @default(cuid())
  organizationId    String
  documentPackageId String
  itemType          DocumentPackageItemType
  documentId        String?
  documentVersionId String?
  evidenceId        String?
  checklistId       String?
  note              String?                 @db.Text
  position          Int                     @default(0)
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentPackage   DocumentPackage         @relation(fields: [documentPackageId], references: [id], onDelete: Cascade)
  document          Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentVersion   DocumentVersion?        @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  evidence          Evidence?               @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  checklist         Checklist?              @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  @@index([organizationId, documentPackageId, position])
  @@index([organizationId, documentId])
  @@index([organizationId, documentVersionId])
  @@index([organizationId, evidenceId])
  @@index([organizationId, checklistId])
}

model ShareLink {
  id                String          @id @default(cuid())
  organizationId    String
  documentPackageId String
  tokenHash         String          @unique
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdById       String
  createdAt         DateTime        @default(now())
  lastAccessedAt    DateTime?
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentPackage   DocumentPackage @relation(fields: [documentPackageId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("ShareLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, documentPackageId])
  @@index([organizationId, revokedAt, expiresAt])
  @@index([organizationId, createdById])
}

model Notification {
  id              String                      @id @default(cuid())
  organizationId  String
  userId          String?
  type            NotificationType
  severity        NotificationSeverity
  title           String
  message         String                      @db.Text
  sourceType      NotificationSourceType
  sourceId        String?
  dedupeKey       String
  actionHref      String?
  readAt          DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDeliveries NotificationEmailDelivery[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, userId, dismissedAt, readAt])
  @@index([organizationId, type, sourceType, sourceId])
  @@index([organizationId, severity, createdAt])
}

model NotificationPreference {
  id                           String               @id @default(cuid())
  organizationId               String
  userId                       String
  emailDigestEnabled           Boolean              @default(false)
  emailDigestFrequency         EmailDigestFrequency @default(OFF)
  emailDigestHour              Int                  @default(8)
  deadlineNotificationsEnabled Boolean              @default(true)
  documentNotificationsEnabled Boolean              @default(true)
  packageNotificationsEnabled  Boolean              @default(true)
  systemNotificationsEnabled   Boolean              @default(true)
  lastDigestSentAt             DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  organization                 Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, emailDigestEnabled, emailDigestFrequency], map: "NotificationPreference_organizationId_emailDigestEnabled_emailD")
  @@index([userId, updatedAt])
}

model DataControlJob {
  id             String               @id @default(cuid())
  organizationId String
  requestedById  String
  type           DataControlJobType
  status         DataControlJobStatus @default(PENDING)
  attemptCount   Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  activeKey      String?              @unique
  blobKey        String?
  resultSummary  Json?
  errorCode      String?
  createdAt      DateTime             @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  requestedBy    User                 @relation("DataControlJobRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, type, status])
  @@index([status, nextAttemptAt, createdAt])
  @@index([requestedById, createdAt])
  @@index([blobKey])
}

model NotificationEmailDelivery {
  id                String                          @id @default(cuid())
  organizationId    String
  userId            String
  notificationId    String?
  type              NotificationEmailDeliveryType
  recipientEmail    String
  notificationCount Int                             @default(0)
  status            NotificationEmailDeliveryStatus
  providerMessageId String?
  errorCode         String?
  sentAt            DateTime?
  createdAt         DateTime                        @default(now())
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification      Notification?                   @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([notificationId])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String           @unique
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  revokedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, role, revokedAt])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole
  tokenHash      String           @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@index([email, expiresAt])
}

model SupportSession {
  id                      String              @id @default(cuid())
  actorId                 String
  organizationId          String
  tokenHash               String              @unique
  reason                  String
  expiresAt               DateTime
  sensitiveConfirmedUntil DateTime?
  endedAt                 DateTime?
  createdAt               DateTime            @default(now())
  actor                   User                @relation("SupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents             SupportAuditEvent[]
  productAuditEvents      ProductAuditEvent[]

  @@index([actorId, endedAt, expiresAt])
  @@index([organizationId, createdAt])
}

model SupportAuditEvent {
  id               String             @id @default(cuid())
  supportSessionId String
  actorId          String
  organizationId   String
  action           SupportAuditAction
  resourceType     String
  resourceId       String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  supportSession   SupportSession     @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  actor            User               @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([supportSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model ProductAuditEvent {
  id               String            @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorRole        OrganizationRole?
  action           AuditAction
  entityType       AuditEntityType
  entityId         String?
  outcome          AuditOutcome
  metadata         Json?
  requestId        String?
  supportSessionId String?
  createdAt        DateTime          @default(now())
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor            User?             @relation("ProductAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  supportSession   SupportSession?   @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId, createdAt], map: "ProductAuditEvent_org_entity_entityId_created_idx")
  @@index([organizationId, outcome, createdAt])
  @@index([actorUserId, createdAt])
  @@index([supportSessionId, createdAt])
}

model UserCredential {
  userId                String   @id
  passwordHash          String
  passwordUpdatedAt     DateTime @default(now())
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id          String          @id @default(cuid())
  userId      String?
  email       String
  purpose     AuthCodePurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model MfaRecoveryRequest {
  id              String            @id @default(cuid())
  userId          String
  organizationId  String?
  mode            MfaRecoveryMode
  status          MfaRecoveryStatus @default(PENDING)
  activeKey       String?           @unique
  emailVerifiedAt DateTime
  expiresAt       DateTime
  approvedById    String?
  approvedAt      DateTime?
  deniedById      String?
  deniedAt        DateTime?
  setupStartedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("MfaRecoverySubject", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedBy      User?             @relation("MfaRecoveryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  deniedBy        User?             @relation("MfaRecoveryDenier", fields: [deniedById], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([approvedById, approvedAt])
  @@index([deniedById, deniedAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  bucket    String
  userId    String?
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bucket, resetAt])
  @@index([userId, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model RuntimeErrorEvent {
  id              String             @id @default(cuid())
  fingerprint     String             @unique
  status          RuntimeErrorStatus @default(OPEN)
  source          String
  routePath       String?
  requestMethod   String?
  errorName       String
  message         String
  stackPreview    String?            @db.Text
  digest          String?
  lastRequestId   String?
  occurrenceCount Int                @default(1)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNote  String?
  resolvedBy      User?              @relation("RuntimeErrorResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, lastSeenAt])
  @@index([source, lastSeenAt])
  @@index([resolvedById, resolvedAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
