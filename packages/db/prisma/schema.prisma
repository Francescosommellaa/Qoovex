generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  START
  PRO
  ENTERPRISE
}

enum RecipeCategory {
  ANTIPASTO
  PRIMO
  SECONDO
  CONTORNO
  DOLCE
  PANE_LIEVITATI
  SALSA_BASE
  BEVANDA
  ALTRO
}

enum RecipeStatus {
  DRAFT
  READY
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum IngredientVerificationStatus {
  VERIFIED
  SUGGESTED
  PENDING_REVIEW
  REJECTED
}

enum IngredientSource {
  USER
  QOOVEX
  OPEN_FOOD_FACTS
  USDA
  OLLAMA
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                  String             @id @default(cuid())
  name                String?
  email               String             @unique
  emailVerified       DateTime?
  image               String?
  firstName           String             @default("")
  lastName            String?
  username            String             @unique
  usernameOnboarded   Boolean            @default(true)
  profileOnboarded    Boolean            @default(true)
  avatarBlobPathname  String?
  phoneNumber         String?
  accounts            Account[]
  sessions            Session[]
  credential          UserCredential?
  authCodes           AuthCode[]
  securityEvents      SecurityAuditEvent[]
  mfaEnabled          Boolean            @default(false)
  totpSecretEncrypted String?
  totpSecretNonce     String?
  totpPendingSecretEncrypted String?
  totpPendingSecretNonce     String?
  totpPendingCreatedAt       DateTime?
  totpVerifiedAt      DateTime?
  usernameChangedAt   DateTime?
  plan                Plan               @default(FREE)
  recipes             Recipe[]
  menus               Menu[]
  shoppingLists       ShoppingList[]
  workPlans           WorkPlan[]         @relation("WorkPlanCreator")
  workPlanMemberships WorkPlanMember[]
  notifications       Notification[]
  recentSearches      RecentSearch[]
  ingredientReviews   IngredientReview[]
  mfaBackupCodes      MfaBackupCode[]
  authDevices         AuthDevice[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model UserCredential {
  userId                String    @id
  passwordHash          String
  passwordUpdatedAt     DateTime  @default(now())
  passwordResetRequired Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id         String          @id @default(cuid())
  userId     String?
  email      String
  purpose    AuthCodePurpose
  codeHash   String
  attempts   Int             @default(0)
  maxAttempts Int            @default(5)
  expiresAt  DateTime
  consumedAt DateTime?
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key     String   @id
  bucket  String
  count   Int      @default(0)
  resetAt DateTime

  @@index([bucket, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, createdAt])
}

model Recipe {
  id                String             @id @default(cuid())
  title             String
  description       String?
  instructions      String?
  category          RecipeCategory     @default(ALTRO)
  status            RecipeStatus       @default(DRAFT)
  servings          Int                @default(4)
  prepTime          Int?
  cookTime          Int?
  imageUrl          String?
  isPublic          Boolean            @default(false)
  totalCalories     Float?
  totalCaloriesMin  Float?
  totalCaloriesMax  Float?
  totalProteins     Float?
  totalProteinsMin  Float?
  totalProteinsMax  Float?
  totalCarbs        Float?
  totalCarbsMin     Float?
  totalCarbsMax     Float?
  totalSugarsMin    Float?
  totalSugarsMax    Float?
  totalFats         Float?
  totalFatsMin      Float?
  totalFatsMax      Float?
  totalFiberMin     Float?
  totalFiberMax     Float?
  totalSaltMin      Float?
  totalSaltMax      Float?
  deletedAt         DateTime?
  authorId          String
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients       RecipeIngredient[]
  menuItems         MenuItem[]
  workTasks         WorkTask[]
  ingredientReviews IngredientReview[]
  likesCount        Int                @default(0)
  forkedFromId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([authorId, deletedAt, updatedAt])
  @@index([authorId, category, status])
  @@index([isPublic, status, updatedAt])
}

model Ingredient {
  id                 String                       @id @default(cuid())
  name               String                       @unique
  slug               String                       @unique
  sourceName         String?
  aliases            String[]                     @default([])
  allergens          String[]
  calories           Float?
  caloriesMin        Float?
  caloriesMax        Float?
  proteins           Float?
  proteinsMin        Float?
  proteinsMax        Float?
  carbs              Float?
  carbsMin           Float?
  carbsMax           Float?
  sugarsMin          Float?
  sugarsMax          Float?
  fats               Float?
  fatsMin            Float?
  fatsMax            Float?
  fiberMin           Float?
  fiberMax           Float?
  saltMin            Float?
  saltMax            Float?
  source             IngredientSource             @default(USER)
  sourceRef          String?
  confidence         Float?
  verificationStatus IngredientVerificationStatus @default(VERIFIED)
  sourceUpdatedAt    DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  recipes            RecipeIngredient[]
  reviews            IngredientReview[]

  @@index([slug])
  @@index([verificationStatus, updatedAt])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model IngredientReview {
  id             String                       @id @default(cuid())
  ingredientId   String?
  recipeId       String?
  userId         String
  rawName        String
  normalizedSlug String
  status         IngredientVerificationStatus @default(PENDING_REVIEW)
  note           String?
  resolvedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  ingredient     Ingredient?                  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  recipe         Recipe?                      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([normalizedSlug, userId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Menu {
  id          String     @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean    @default(false)
  qrCodeUrl   String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  recipeId String
  position Int
  section  String?
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipe   Recipe  @relation(fields: [recipeId], references: [id])

  @@unique([menuId, position])
}

model ShoppingList {
  id        String             @id @default(cuid())
  title     String
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  name           String
  quantity       Float
  unit           String
  checked        Boolean      @default(false)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

model WorkPlan {
  id          String           @id @default(cuid())
  title       String
  description String?
  creatorId   String
  creator     User             @relation("WorkPlanCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     WorkPlanMember[]
  tasks       WorkTask[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model WorkPlanMember {
  id         String   @id @default(cuid())
  workPlanId String
  userId     String
  joinedAt   DateTime @default(now())
  workPlan   WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workPlanId, userId])
}

model WorkTask {
  id             String    @id @default(cuid())
  workPlanId     String
  title          String
  description    String?
  recipeId       String?
  recipeSnapshot Json?
  completedAt    DateTime?
  completedBy    String?
  position       Int
  workPlan       WorkPlan  @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  recipe         Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  data      Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
