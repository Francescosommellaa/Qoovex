model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                          String                                @id @default(cuid())
  name                        String?
  email                       String                                @unique
  emailVerified               DateTime?
  image                       String?
  firstName                   String                                @default("")
  lastName                    String?
  username                    String                                @unique
  usernameOnboarded           Boolean                               @default(true)
  profileOnboarded            Boolean                               @default(true)
  avatarBlobPathname          String?
  phoneNumber                 String?
  platformRole                PlatformRole                          @default(USER)
  authVersion                 Int                                   @default(1)
  suspendedAt                 DateTime?
  suspensionReason            String?
  accounts                    Account[]
  sessions                    Session[]
  credential                  UserCredential?
  authCodes                   AuthCode[]
  authRateLimits              AuthRateLimit[]
  securityEvents              SecurityAuditEvent[]
  mfaEnabled                  Boolean                               @default(false)
  totpSecretEncrypted         String?
  totpSecretNonce             String?
  totpPendingSecretEncrypted  String?
  totpPendingSecretNonce      String?
  totpPendingCreatedAt        DateTime?
  totpVerifiedAt              DateTime?
  usernameChangedAt           DateTime?
  mfaBackupCodes              MfaBackupCode[]
  mfaRecoveryRequests         MfaRecoveryRequest[]                  @relation("MfaRecoverySubject")
  approvedMfaRecoveries       MfaRecoveryRequest[]                  @relation("MfaRecoveryApprover")
  deniedMfaRecoveries         MfaRecoveryRequest[]                  @relation("MfaRecoveryDenier")
  authDevices                 AuthDevice[]
  organizationMembership      OrganizationMembership?
  createdOrganizations        Organization[]                        @relation("OrganizationCreator")
  sentOrganizationInvitations OrganizationInvitation[]              @relation("InvitationSender")
  grantedMembershipResources  OrganizationMembershipResourceGrant[] @relation("MembershipResourceGrantActor")
  supportSessions             SupportSession[]                      @relation("SupportActor")
  supportAuditEvents          SupportAuditEvent[]                   @relation("SupportAuditActor")
  productAuditEvents          ProductAuditEvent[]                   @relation("ProductAuditActor")
  reviewedDocuments           Document[]                            @relation("DocumentReviewer")
  uploadedDocumentVersions    DocumentVersion[]                     @relation("DocumentVersionUploader")
  completedChecklistItems     ChecklistItem[]                       @relation("ChecklistItemCompleter")
  createdEvidence             Evidence[]                            @relation("EvidenceCreator")
  createdDocumentPackages     DocumentPackage[]                     @relation("DocumentPackageCreator")
  createdShareLinks           ShareLink[]                           @relation("ShareLinkCreator")
  preparedPackageRevisions    DocumentPackageRevision[]             @relation("DocumentPackageRevisionPreparer")
  approvedPackageRevisions    DocumentPackageRevision[]             @relation("DocumentPackageRevisionApprover")
  createdShareProposals       DocumentPackageShareProposal[]        @relation("DocumentPackageShareProposalCreator")
  approvedShareProposals      DocumentPackageShareProposal[]        @relation("DocumentPackageShareProposalApprover")
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  notificationEmailDeliveries NotificationEmailDelivery[]
  requestedDataControlJobs    DataControlJob[]                      @relation("DataControlJobRequester")
  resolvedRuntimeErrors       RuntimeErrorEvent[]                   @relation("RuntimeErrorResolver")
  workerUserLinks             WorkerUserLink[]
  linkedWorkerUserLinks       WorkerUserLink[]                      @relation("WorkerUserLinkCreator")
  jobSiteUserAssignments      JobSiteUserAssignment[]
  assignedJobSiteUsers        JobSiteUserAssignment[]               @relation("JobSiteUserAssignmentCreator")
  assignedJobSiteWorkers      JobSiteWorkerAssignment[]             @relation("JobSiteWorkerAssignmentCreator")
  createdCalendarEvents       CalendarEvent[]                       @relation("CalendarEventCreator")
  assignedCalendarEvents      CalendarEvent[]                       @relation("CalendarEventAssignee")
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt
}

model Organization {
  id                            String                                @id @default(cuid())
  name                          String
  code                          String                                @unique
  createdById                   String?
  createdAt                     DateTime                              @default(now())
  updatedAt                     DateTime                              @updatedAt
  createdBy                     User?                                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships                   OrganizationMembership[]
  invitations                   OrganizationInvitation[]
  membershipResourceGrants      OrganizationMembershipResourceGrant[]
  invitationResourceGrants      OrganizationInvitationResourceGrant[]
  supportSessions               SupportSession[]
  supportEvents                 SupportAuditEvent[]
  productAuditEvents            ProductAuditEvent[]
  mfaRecoveryRequests           MfaRecoveryRequest[]
  workers                       Worker[]
  jobSites                      JobSite[]
  documentTypes                 DocumentType[]
  documents                     Document[]
  documentVersions              DocumentVersion[]
  documentRequirements          DocumentRequirement[]
  deadlines                     Deadline[]
  calendarEvents                CalendarEvent[]
  checklists                    Checklist[]
  checklistItems                ChecklistItem[]
  evidence                      Evidence[]
  documentPackages              DocumentPackage[]
  documentPackageItems          DocumentPackageItem[]
  documentPackageRevisions      DocumentPackageRevision[]
  documentPackageShareProposals DocumentPackageShareProposal[]
  shareLinks                    ShareLink[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  notificationEmailDeliveries   NotificationEmailDelivery[]
  workerUserLinks               WorkerUserLink[]
  jobSiteUserAssignments        JobSiteUserAssignment[]
  jobSiteWorkerAssignments      JobSiteWorkerAssignment[]
  operationalProcesses          OperationalProcess[]
  operationalSteps              OperationalStep[]
  operationalEvents             OperationalEvent[]
  operationalEventArtifactRefs  OperationalEventArtifactReference[]
  operationalDecisions          OperationalDecision[]
  operationalExceptions         OperationalException[]
  operationalArtifactRefs       OperationalArtifactReference[]
  operationalRuleSnapshots      OperationalRuleSnapshot[]
  operationalEffectReceipts     OperationalEffectReceipt[]

  @@index([name])
}

model Worker {
  id                 String                    @id @default(cuid())
  organizationId     String
  displayName        String
  email              String?
  phone              String?
  roleLabel          String?
  status             RecordStatus              @default(ACTIVE)
  notes              String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  archivedAt         DateTime?
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          Document[]
  deadlines          Deadline[]
  evidence           Evidence[]
  userLinks          WorkerUserLink[]
  jobSiteAssignments JobSiteWorkerAssignment[]
  invitations        OrganizationInvitation[]

  @@index([organizationId, status])
  @@index([organizationId, displayName])
  @@index([organizationId, email])
}

model JobSite {
  id                String                    @id @default(cuid())
  organizationId    String
  name              String
  address           String?
  clientName        String?
  status            RecordStatus              @default(ACTIVE)
  operationalPhase  JobSiteOperationalPhase?
  startDate         DateTime?
  endDate           DateTime?
  notes             String?                   @db.Text
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents         Document[]
  requirements      DocumentRequirement[]
  deadlines         Deadline[]
  calendarEvents    CalendarEvent[]
  checklists        Checklist[]
  evidence          Evidence[]
  documentPackages  DocumentPackage[]
  userAssignments   JobSiteUserAssignment[]
  workerAssignments JobSiteWorkerAssignment[]

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, clientName])
  @@index([organizationId, operationalPhase, archivedAt], map: "JobSite_org_phase_archived_idx")
}

model WorkerUserLink {
  id             String       @id @default(cuid())
  organizationId String
  workerId       String
  userId         String
  linkedById     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedBy       User         @relation("WorkerUserLinkCreator", fields: [linkedById], references: [id], onDelete: Restrict)

  @@index([organizationId, workerId, archivedAt])
  @@index([organizationId, userId, archivedAt])
  @@index([organizationId, createdAt])
  @@index([linkedById])
}

model JobSiteUserAssignment {
  id             String                    @id @default(cuid())
  organizationId String
  jobSiteId      String
  userId         String
  assignmentRole JobSiteUserAssignmentRole @default(SITE_MANAGER)
  assignedById   String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  archivedAt     DateTime?
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite                   @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User                      @relation("JobSiteUserAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, jobSiteId, assignmentRole, archivedAt], map: "JobSiteUserAssignment_org_job_role_archived_idx")
  @@index([organizationId, userId, assignmentRole, archivedAt], map: "JobSiteUserAssignment_org_user_role_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
}

model JobSiteWorkerAssignment {
  id             String       @id @default(cuid())
  organizationId String
  jobSiteId      String
  workerId       String
  assignedById   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobSite        JobSite      @relation(fields: [jobSiteId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignedBy     User         @relation("JobSiteWorkerAssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([organizationId, jobSiteId, archivedAt], map: "JobSiteWorkerAssignment_org_job_archived_idx")
  @@index([organizationId, workerId, archivedAt], map: "JobSiteWorkerAssignment_org_worker_archived_idx")
  @@index([organizationId, createdAt])
  @@index([assignedById])
}

model DocumentType {
  id                 String                @id @default(cuid())
  organizationId     String
  name               String
  description        String?               @db.Text
  appliesTo          DocumentTypeAppliesTo
  categoryKey        DocumentCategoryKey   @default(UNCLASSIFIED)
  sensitivity        DocumentSensitivity   @default(STANDARD)
  requiresExpiryDate Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  archivedAt         DateTime?
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          Document[]
  requirements       DocumentRequirement[]

  @@index([organizationId, appliesTo])
  @@index([organizationId, categoryKey, archivedAt], map: "DocumentType_org_category_archived_idx")
  @@index([organizationId, name])
}

model Document {
  id             String                @id @default(cuid())
  organizationId String
  documentTypeId String?
  ownerType      DocumentOwnerType
  workerId       String?
  jobSiteId      String?
  title          String
  status         DocumentStatus        @default(TO_REVIEW)
  expiryDate     DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  archivedAt     DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   DocumentType?         @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  worker         Worker?               @relation(fields: [workerId], references: [id], onDelete: SetNull)
  jobSite        JobSite?              @relation(fields: [jobSiteId], references: [id], onDelete: SetNull)
  reviewedBy     User?                 @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]
  deadlines      Deadline[]
  packageItems   DocumentPackageItem[]

  @@index([organizationId, status])
  @@index([organizationId, ownerType])
  @@index([organizationId, workerId])
  @@index([organizationId, jobSiteId])
  @@index([organizationId, documentTypeId])
  @@index([organizationId, expiryDate])
  @@index([organizationId, title])
}

model DocumentVersion {
  id               String                @id @default(cuid())
  organizationId   String
  documentId       String
  blobKey          String
