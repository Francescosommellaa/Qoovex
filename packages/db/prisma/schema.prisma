generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  SAFETY_CONSULTANT
  SITE_MANAGER
  WORKER
  VIEWER
}

enum SupportAuditAction {
  READ
  WRITE
  SENSITIVE
  EXPORT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider           String
  providerAccountId String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                         String               @id @default(cuid())
  name                       String?
  email                      String               @unique
  emailVerified              DateTime?
  image                      String?
  firstName                  String               @default("")
  lastName                   String?
  username                   String               @unique
  usernameOnboarded          Boolean              @default(true)
  profileOnboarded           Boolean              @default(true)
  avatarBlobPathname         String?
  phoneNumber                String?
  platformRole               PlatformRole         @default(USER)
  authVersion                Int                  @default(1)
  accounts                   Account[]
  sessions                   Session[]
  credential                 UserCredential?
  authCodes                  AuthCode[]
  securityEvents             SecurityAuditEvent[]
  mfaEnabled                 Boolean              @default(false)
  totpSecretEncrypted        String?
  totpSecretNonce            String?
  totpPendingSecretEncrypted String?
  totpPendingSecretNonce     String?
  totpPendingCreatedAt       DateTime?
  totpVerifiedAt             DateTime?
  usernameChangedAt          DateTime?
  mfaBackupCodes             MfaBackupCode[]
  authDevices                AuthDevice[]
  organizationMemberships    OrganizationMembership[]
  createdOrganizations       Organization[]           @relation("OrganizationCreator")
  sentOrganizationInvitations OrganizationInvitation[] @relation("InvitationSender")
  supportSessions            SupportSession[]      @relation("SupportActor")
  supportAuditEvents         SupportAuditEvent[]   @relation("SupportAuditActor")
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
}

model Organization {
  id             String                @id @default(cuid())
  name           String
  code           String                @unique
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      User?                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships    OrganizationMembership[]
  invitations    OrganizationInvitation[]
  supportSessions SupportSession[]
  supportEvents  SupportAuditEvent[]

  @@index([name])
  @@map("Structure")
}

model OrganizationMembership {
  id          String        @id @default(cuid())
  organizationId String    @map("structureId")
  userId      String
  role        OrganizationRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  revokedAt   DateTime?
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, revokedAt])
  @@index([organizationId, role, revokedAt])
  @@map("StructureMembership")
}

model OrganizationInvitation {
  id          String        @id @default(cuid())
  organizationId String    @map("structureId")
  email       String
  role        OrganizationRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@index([email, expiresAt])
  @@map("StructureInvitation")
}

model SupportSession {
  id                     String              @id @default(cuid())
  actorId                String
  organizationId         String              @map("structureId")
  tokenHash              String              @unique
  reason                 String
  expiresAt              DateTime
  sensitiveConfirmedUntil DateTime?
  endedAt                DateTime?
  createdAt              DateTime            @default(now())
  actor                  User                @relation("SupportActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents            SupportAuditEvent[]

  @@index([actorId, endedAt, expiresAt])
  @@index([organizationId, createdAt])
}

model SupportAuditEvent {
  id               String             @id @default(cuid())
  supportSessionId String
  actorId          String
  organizationId   String             @map("structureId")
  action           SupportAuditAction
  resourceType     String
  resourceId       String?
  metadata         Json?
  createdAt        DateTime           @default(now())
  supportSession   SupportSession     @relation(fields: [supportSessionId], references: [id], onDelete: Cascade)
  actor            User               @relation("SupportAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([supportSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model UserCredential {
  userId                String   @id
  passwordHash          String
  passwordUpdatedAt     DateTime @default(now())
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCode {
  id          String          @id @default(cuid())
  userId      String?
  email       String
  purpose     AuthCodePurpose
  codeHash    String
  attempts    Int             @default(0)
  maxAttempts Int             @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model AuthRateLimit {
  key     String   @id
  bucket  String
  count   Int      @default(0)
  resetAt DateTime

  @@index([bucket, resetAt])
}

model SecurityAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model AuthDevice {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String
  userAgentHash   String?
  label           String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId, lastSeenAt])
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}
