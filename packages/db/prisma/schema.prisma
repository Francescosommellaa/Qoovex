generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  START
  PRO
  ENTERPRISE
}

model User {
  id                  String           @id @default(cuid())
  clerkId             String           @unique
  name                String
  email               String           @unique
  plan                Plan             @default(FREE)
  recipes             Recipe[]
  menus               Menu[]
  shoppingLists       ShoppingList[]
  workPlans           WorkPlan[]       @relation("WorkPlanCreator")
  workPlanMemberships WorkPlanMember[]
  notifications       Notification[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Recipe {
  id              String             @id @default(cuid())
  title           String
  description     String?
  instructions    String?
  servings        Int                @default(4)
  prepTime        Int?
  cookTime        Int?
  imageUrl        String?
  isPublic        Boolean            @default(false)
  authorId        String
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients     RecipeIngredient[]
  menuItems       MenuItem[]
  workTasks       WorkTask[]
  likesCount      Int                @default(0)
  forkedFromId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Ingredient {
  id          String             @id @default(cuid())
  name        String             @unique
  allergens   String[]
  calories    Float?
  proteins    Float?
  carbs       Float?
  fats        Float?
  recipes     RecipeIngredient[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
}

model Menu {
  id          String     @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean    @default(false)
  qrCodeUrl   String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  recipeId String
  position Int
  section  String?
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipe   Recipe  @relation(fields: [recipeId], references: [id])

  @@unique([menuId, position])
}

model ShoppingList {
  id        String             @id @default(cuid())
  title     String
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  name           String
  quantity       Float
  unit           String
  checked        Boolean      @default(false)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

model WorkPlan {
  id          String           @id @default(cuid())
  title       String
  description String?
  creatorId   String
  creator     User             @relation("WorkPlanCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     WorkPlanMember[]
  tasks       WorkTask[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model WorkPlanMember {
  id         String   @id @default(cuid())
  workPlanId String
  userId     String
  joinedAt   DateTime @default(now())
  workPlan   WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workPlanId, userId])
}

model WorkTask {
  id             String    @id @default(cuid())
  workPlanId     String
  title          String
  description    String?
  recipeId       String?
  recipeSnapshot Json?
  completedAt    DateTime?
  completedBy    String?
  position       Int
  workPlan       WorkPlan  @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  recipe         Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  data      Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
