{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"scripts/impeccable/hook-dispatcher.mjs\" ] || node \"scripts/impeccable/hook-dispatcher.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if exist \"scripts/impeccable/hook-dispatcher.mjs\" (node \"scripts/impeccable/hook-dispatcher.mjs\" & exit /b)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"scripts/impeccable/hook-dispatcher.mjs\" ] || node \"scripts/impeccable/hook-dispatcher.mjs\"",
            "timeout": 60,
            "statusMessage": "Design deep pass",
            "commandWindows": "if exist \"scripts/impeccable/hook-dispatcher.mjs\" (node \"scripts/impeccable/hook-dispatcher.mjs\" & exit /b)"
          }
        ]
      }
    ]
  }
}
