# Qoovex Workspace
#
# Non inserire segreti reali in questo file.
# Locale workspace: http://localhost:3001
# Produzione workspace: https://app.qoovex.com

# -----------------------------------------------------------------------------
# Auth.js v5 / NextAuth
# -----------------------------------------------------------------------------
# URL canonico dell'app workspace.
AUTH_URL=http://localhost:3001

# Obbligatorio in produzione. Minimo 32 caratteri.
AUTH_SECRET=

# Solo sviluppo: accesso rapido/dev-auth e fallback auth locale.
# Minimo 32 caratteri. Non usare in produzione.
DEV_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Database PostgreSQL / Prisma
# -----------------------------------------------------------------------------
# Obbligatorio. Usa DATABASE_URL salvo provider che esponga uno degli alias.
DATABASE_URL=
DATABASE_PRISMA_DATABASE_URL=
DATABASE_POSTGRES_URL=

# -----------------------------------------------------------------------------
# Email transazionali — Resend
# -----------------------------------------------------------------------------
# Obbligatorio per verifica email, inviti, reset password, notifiche e digest.
# Senza provider l'invio fallisce in modo sicuro: destinatario, OTP e token non
# vengono mai stampati nei log. Il sink seguente e riservato a Playwright E2E.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
QOOVEX_E2E_MODE=0
QOOVEX_E2E_EMAIL_SINK_URL=
QOOVEX_E2E_EMAIL_SINK_SECRET=
# Preflight Playwright fail-closed. I target devono coincidere esattamente con
# le variabili runtime e l'attestazione va fornita esplicitamente a ogni run.
QOOVEX_E2E_DATABASE_TARGET=
QOOVEX_E2E_BLOB_TARGET=
QOOVEX_E2E_RUN_ATTESTATION=

# -----------------------------------------------------------------------------
# Segreti Qoovex server-side
# -----------------------------------------------------------------------------
# Usa valori casuali lunghi e stabili. Non cambiarli dopo dati reali senza piano.
QOOVEX_AUTH_CODE_SECRET=
QOOVEX_PASSWORD_PEPPER=
QOOVEX_AUDIT_SECRET=
QOOVEX_MFA_ENCRYPTION_KEY=
QOOVEX_MFA_COOKIE_SECRET=

# Endpoint schedulati. GitHub Actions invia Authorization: Bearer <secret>.
CRON_SECRET=

# -----------------------------------------------------------------------------
# OAuth Google (opzionale)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Vercel Blob privato — documenti, PDF, foto, prove di cantiere
# -----------------------------------------------------------------------------
# Produzione su Vercel: preferire OIDC quando disponibile.
# Locale o runtime fuori Vercel: usare BLOB_READ_WRITE_TOKEN valido.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
