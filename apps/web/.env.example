# Qoovex Web — copia questo file in `apps/web/.env.local`
#
# Non inserire segreti reali in questo file.

# URL del workspace usato dal sito pubblico per mandare utenti all'app.
# Locale: http://localhost:3001
# Produzione: https://app.qoovex.com
#
# Variabile pubblica: viene inclusa nel bundle browser.
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:3001
