{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "globalEnv": [
    "AUTH_SECRET",
    "AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_REPLY_TO_EMAIL",
    "OLLAMA_BASE_URL",
    "OLLAMA_MODEL",
    "FOODDATA_CENTRAL_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_POSTGRES_URL",
        "DATABASE_PRISMA_DATABASE_URL",
        "BLOB_READ_WRITE_TOKEN",
        "AUTH_SECRET",
        "AUTH_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "RESEND_REPLY_TO_EMAIL",
        "DEV_AUTH_SECRET",
        "QOOVEX_MFA_ENCRYPTION_KEY",
        "QOOVEX_MFA_COOKIE_SECRET",
        "OLLAMA_BASE_URL",
        "OLLAMA_MODEL",
        "FOODDATA_CENTRAL_API_KEY"
      ]
    },
    "@qoovex/db#build": {
      "cache": false
    },
    "@qoovex/brand#build": {
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
