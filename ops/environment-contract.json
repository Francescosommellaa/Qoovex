{
  "schemaVersion": 1,
  "groups": {
    "database": {
      "anyOf": ["DATABASE_URL", "DATABASE_PRISMA_DATABASE_URL", "DATABASE_POSTGRES_URL"],
      "marker": "QOOVEX_DATABASE_ENVIRONMENT"
    },
    "auth": {
      "required": ["AUTH_URL", "AUTH_SECRET"],
      "optional": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
    },
    "mfa": {
      "required": ["QOOVEX_MFA_ENCRYPTION_KEY", "QOOVEX_MFA_COOKIE_SECRET"]
    },
    "credentials": {
      "required": ["QOOVEX_AUTH_CODE_SECRET", "QOOVEX_PASSWORD_PEPPER"]
    },
    "audit": {
      "required": ["QOOVEX_AUDIT_SECRET"]
    },
    "scheduler": {
      "required": ["CRON_SECRET"]
    },
    "blob": {
      "required": ["BLOB_READ_WRITE_TOKEN", "BLOB_STORE_ID"]
    },
    "email": {
      "required": ["RESEND_API_KEY", "RESEND_FROM_EMAIL"],
      "optional": ["RESEND_REPLY_TO_EMAIL"]
    },
    "jobSiteData": {
      "inactiveOptional": ["QOOVEX_DATA_ENCRYPTION_KEYS", "QOOVEX_DATA_ENCRYPTION_ACTIVE_KEY_ID"]
    }
  },
  "environments": {
    "local": {
      "databaseMarker": "local",
      "requiredGroups": ["database", "auth", "mfa", "credentials", "audit", "scheduler"],
      "optionalGroups": ["blob", "email", "jobSiteData"],
      "devAuth": "allowed_loopback_only"
    },
    "test": {
      "databaseMarker": "test",
      "requiredGroups": ["database", "auth", "mfa", "credentials", "audit", "scheduler"],
      "optionalGroups": ["blob", "email", "jobSiteData"],
      "externalDelivery": "mock_only"
    },
    "ci": {
      "databaseMarker": "test",
      "requiredGroups": ["database", "auth", "mfa", "credentials", "audit", "scheduler"],
      "optionalGroups": ["blob", "email", "jobSiteData"],
      "externalDelivery": "isolated_mock_or_sink"
    },
    "preview": {
      "databaseMarker": "preview",
      "requiredGroups": ["database", "auth", "mfa", "credentials", "audit", "scheduler", "blob", "email"],
      "optionalGroups": ["jobSiteData"],
      "dataPolicy": "synthetic_only",
      "isolation": ["database", "blob", "auth_callback", "secrets", "email_sink"]
    },
    "production": {
      "databaseMarker": "production",
      "requiredGroups": ["database", "auth", "mfa", "credentials", "audit", "scheduler", "blob", "email"],
      "optionalGroups": ["jobSiteData"],
      "authUrl": "https://app.qoovex.com",
      "devAuth": "forbidden"
    }
  }
}
