{
  "schemaVersion": 2,
  "application": {
    "name": "qoovex-workspace",
    "version": "single-organization-membership-v1",
    "runtimeTrack": "job-site",
    "current": "implemented_not_end_to_end_verified"
  },
  "database": {
    "baselineHead": "20260720010000_calendar_events",
    "migrationHead": "20260809020000_single_active_organization_membership",
    "migrationCount": 8,
    "productionMutationRequiredForAlignment": true,
    "rolloutMode": "manual_cloud_build_forward_deploy",
    "ledger": "ops/migration-ledger.json"
  },
  "blob": {
    "access": "private",
    "rolloutMode": "manual_only_one_time_store_reset_blocked",
    "targetIdentity": "BLOB_STORE_ID",
    "resetScript": "apps/workspace/scripts/reset-private-blob-store.mjs"
  },
  "scheduler": {
    "permanentReleaseState": "enabled_job-site",
    "jobs": [
      {
        "id": "data-control",
        "method": "GET",
        "path": "/api/data/jobs/run"
      },
      {
        "id": "job-site-processes",
        "method": "POST",
        "path": "/api/internal/job-sites/processes/run"
      }
    ],
    "forbiddenJobs": ["digest", "legacy-operational"]
  },
  "http": {
    "anonymousProtectedPage": "307_sign_in_with_sanitized_relative_callback",
    "staleSession": "controlled_application_state",
    "anonymousProtectedApi": 401,
    "forbiddenProtectedApi": 403,
    "unknownApi": 404
  },
  "environmentContract": "ops/environment-contract.json",
  "previewRelease": {
    "automaticGitDeployment": "disabled",
    "trigger": "manual_workflow_dispatch_exact_confirmation",
    "workflow": ".github/workflows/rehearse-workspace-preview.yml",
    "database": "cloud_build_forward_deploy",
    "blob": "unchanged"
  },
  "productionRelease": {
    "trigger": "manual_workflow_dispatch_after_green_ci_exact_confirmation",
    "deploymentMode": "staged_then_promoted",
    "workflow": ".github/workflows/release-workspace.yml",
    "migrationCommand": "cloud-build:prisma-migrate-deploy",
    "promotionCommand": "vercel promote"
  }
}
