{
  "schemaVersion": 2,
  "application": {
    "name": "qoovex-workspace",
    "version": "vnext-from-zero-v1",
    "runtimeTrack": "vnext",
    "vNext": "implemented"
  },
  "database": {
    "baselineHead": "20260720010000_calendar_events",
    "migrationHead": "20260803230000_qoovex_vnext_from_zero",
    "migrationCount": 6,
    "productionMutationRequiredForAlignment": true,
    "rolloutMode": "authorized_empty_database_reset",
    "ledger": "ops/migration-ledger.json"
  },
  "blob": {
    "access": "private",
    "rolloutMode": "one_time_store_reset_before_database_migration",
    "targetIdentity": "BLOB_STORE_ID",
    "resetScript": "apps/workspace/scripts/reset-vnext-blob-store.mjs"
  },
  "scheduler": {
    "permanentReleaseState": "enabled_vnext",
    "jobs": [
      {
        "id": "data-control",
        "method": "GET",
        "path": "/api/data/jobs/run"
      },
      {
        "id": "vnext-processes",
        "method": "POST",
        "path": "/api/internal/vnext/processes/run"
      }
    ],
    "forbiddenJobs": ["digest", "legacy-operational"]
  },
  "http": {
    "anonymousProtectedPage": "307_sign_in_with_sanitized_relative_callback",
    "staleSession": "controlled_application_state",
    "anonymousProtectedApi": 401,
    "forbiddenProtectedApi": 403,
    "unknownApi": 404
  },
  "environmentContract": "ops/environment-contract.json",
  "previewRelease": {
    "automaticGitDeployment": "workflow_on_non_master_push",
    "workflow": ".github/workflows/rehearse-workspace-preview.yml",
    "database": "isolated_reset",
    "blob": "isolated_reset"
  },
  "productionRelease": {
    "trigger": "successful_ci_on_master",
    "deploymentMode": "staged_then_promoted",
    "workflow": ".github/workflows/release-workspace.yml",
    "migrationCommand": "prisma migrate deploy",
    "promotionCommand": "vercel promote"
  }
}
