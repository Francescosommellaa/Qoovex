# Qoovex monorepo — template variabili ambiente
#
# Copia i valori reali in file non versionati:
# - apps/workspace/.env.local per l'app prodotto
# - apps/web/.env.local per il sito pubblico
# - opzionale: packages/db/.env o variabili shell per comandi Prisma diretti
#
# Non inserire segreti reali in questo file.

# -----------------------------------------------------------------------------
# Database PostgreSQL / Prisma
# -----------------------------------------------------------------------------
# Obbligatorio per workspace, Auth.js adapter e Prisma.
# Il codice DB accetta una di queste tre variabili, in ordine:
DATABASE_URL=
DATABASE_PRISMA_DATABASE_URL=
DATABASE_POSTGRES_URL=

# -----------------------------------------------------------------------------
# Workspace URL / Auth.js
# -----------------------------------------------------------------------------
# Locale workspace: http://localhost:3001
# Produzione workspace: https://app.qoovex.com
AUTH_URL=http://localhost:3001

# Obbligatorio in produzione. Minimo 32 caratteri.
AUTH_SECRET=


# Solo sviluppo locale: abilita dev-auth e fallback auth in dev.
# Minimo 32 caratteri. Non usarlo come meccanismo auth in produzione.
DEV_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Segreti Qoovex server-side
# -----------------------------------------------------------------------------
# Generali: stringhe casuali lunghe, stabili e diverse fra loro.
# Non cambiarle dopo aver creato utenti/dati reali senza piano di rotazione.
QOOVEX_AUTH_CODE_SECRET=
QOOVEX_PASSWORD_PEPPER=
QOOVEX_AUDIT_SECRET=
QOOVEX_MFA_ENCRYPTION_KEY=
QOOVEX_MFA_COOKIE_SECRET=

# Endpoint digest email schedulabile.
# Il codice attuale usa header x-qoovex-cron-secret.
QOOVEX_CRON_SECRET=

# -----------------------------------------------------------------------------
# Email transazionali — Resend
# -----------------------------------------------------------------------------
# In produzione sono necessari per verifica email, inviti, reset password,
# notifiche e digest. In locale puoi lasciarli vuoti per logging console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# OAuth Google opzionale
# -----------------------------------------------------------------------------
# Configura solo quando vuoi attivare il provider Google in Auth.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Vercel Blob privato
# -----------------------------------------------------------------------------
# Produzione su Vercel: preferire OIDC quando disponibile.
# Locale o runtime fuori Vercel: usare BLOB_READ_WRITE_TOKEN valido.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# -----------------------------------------------------------------------------
# Web pubblico
# -----------------------------------------------------------------------------
# Esposto al browser. Non inserire segreti in variabili NEXT_PUBLIC_*.
NEXT_PUBLIC_WORKSPACE_URL=http://localhost:3001
