{
  "name": "qoovex",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate --filter=@qoovex/db",
    "db:push": "turbo run db:push --filter=@qoovex/db",
    "db:migrate": "turbo run db:migrate --filter=@qoovex/db",
    "db:workspace": "turbo run db:workspace --filter=@qoovex/db"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [],
      "allowedVersions": {
        "@clerk/nextjs>react": "19",
        "@clerk/nextjs>react-dom": "19"
      }
    }
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  }
}
