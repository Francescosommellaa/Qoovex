{
  "name": "qoovex",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "dev": "pnpm db:start:local && turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "check": "pnpm type-check && pnpm test:unit && pnpm check:build && pnpm check:audit && pnpm --filter @qoovex/db verify:prisma && git diff --check",
    "check:build": "pnpm build",
    "check:audit": "pnpm audit --prod",
    "check:fast": "pnpm type-check",
    "check:contracts": "node scripts/verify-migration-ledger.mjs && node scripts/classify-migration-sql.mjs && node scripts/verify-release-contracts.mjs && node scripts/verify-build-migration-safety.mjs && node scripts/verify-monorepo-boundaries.mjs",
    "check:push": "git diff HEAD --check && pnpm check:fast && pnpm check:contracts && pnpm --filter @qoovex/db exec prisma validate",
    "smoke:workspace": "node scripts/smoke-workspace-runtime.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "ci:db:prepare": "pnpm --filter @qoovex/db db:migrate:deploy -- --ci-ephemeral",
    "ci:install": "pnpm install --frozen-lockfile",
    "deps:update": "pnpm --workspace-root update --include-github-actions && pnpm update --recursive",
    "deps:update:major": "pnpm --workspace-root update --latest --interactive --include-github-actions && pnpm update --recursive --latest --interactive",
    "setup:impeccable": "node scripts/impeccable/setup.mjs",
    "verify:impeccable": "node scripts/impeccable/verify.mjs",
    "skills:doctor": "node scripts/skills/doctor.mjs",
    "skills:test": "node --test scripts/skills/*.test.mjs",
    "skills:route": "node scripts/skills/orchestrator.mjs route",
    "skills:canary": "node scripts/skills/orchestrator.mjs canary",
    "skills:sync": "node scripts/skills/sync.mjs",
    "skills:update:check": "node scripts/skills/update-check.mjs",
    "ui-skills:start": "npx --yes ui-skills@0.2.4 start",
    "ui-skills:categories": "npx --yes ui-skills@0.2.4 categories",
    "ui-skills:list": "npx --yes ui-skills@0.2.4 list",
    "ui-skills:get": "npx --yes ui-skills@0.2.4 get",
    "mobile:contract": "node scripts/mobile/contract.mjs",
    "mobile:doctor": "node scripts/mobile/doctor.mjs",
    "mobile:impact": "node scripts/mobile/impact.mjs",
    "mobile:test": "node scripts/mobile/run-playwright.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "visual:geometry": "node scripts/visual-geometry/run.mjs run",
    "visual:geometry:update": "node scripts/visual-geometry/run.mjs update",
    "visual:geometry:report": "node scripts/visual-geometry/report.mjs",
    "visual:geometry:self-test": "node scripts/visual-geometry/run.mjs self-test",
    "test:unit": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@qoovex/db",
    "db:push": "turbo run db:push --filter=@qoovex/db",
    "db:migrate": "turbo run db:migrate --filter=@qoovex/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@qoovex/db",
    "db:start:local": "pnpm --filter @qoovex/db db:start:local",
    "db:workspace": "turbo run db:workspace --filter=@qoovex/db"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.11"
  }
}
