{
  "name": "qoovex",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "check": "pnpm check:repo && pnpm lint && pnpm type-check && pnpm check:build && pnpm check:audit",
    "check:repo": "node scripts/repo-guard.mjs",
    "check:build": "node scripts/check-builds.mjs",
    "check:audit": "node scripts/lighthouse-audit.mjs",
    "check:fast": "pnpm check:repo && pnpm lint && pnpm type-check",
    "check:ci": "pnpm check",
    "db:generate": "turbo run db:generate --filter=@qoovex/db",
    "db:push": "turbo run db:push --filter=@qoovex/db",
    "db:migrate": "turbo run db:migrate --filter=@qoovex/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@qoovex/db",
    "db:workspace": "turbo run db:workspace --filter=@qoovex/db"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lighthouse": "^12.8.2",
    "tsx": "^4.20.6",
    "turbo": "^2.9.14"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^12.9.0"
  }
}
