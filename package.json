{
  "name": "qoovex",
  "private": true,
  "packageManager": "pnpm@11.16.0+sha512.b767e9a98fc87aec0f42daefcd0e84941c2cdb45d73c4e1e68860fb2bdfdbe032ab592105479e5e05c237f740c8a5ffdbbb52385797ddc2296745a1bbb883e8d",
  "scripts": {
    "dev": "pnpm db:start:local && turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "check": "pnpm type-check && pnpm test:unit && pnpm check:build && pnpm check:audit && pnpm --filter @qoovex/db verify:prisma && git diff --check",
    "check:build": "pnpm build",
    "check:audit": "pnpm audit --prod",
    "check:fast": "pnpm type-check",
    "check:ci": "pnpm check && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@qoovex/db",
    "db:push": "turbo run db:push --filter=@qoovex/db",
    "db:migrate": "turbo run db:migrate --filter=@qoovex/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@qoovex/db",
    "db:start:local": "pnpm --filter @qoovex/db db:start:local",
    "db:workspace": "turbo run db:workspace --filter=@qoovex/db"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "turbo": "^2.10.5"
  }
}
